{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build -w @crista-web/web",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/crista/",
      "permanent": false
    },
    {
      "source": "/crista",
      "destination": "/crista/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/crista/:path((?!api/|ws$|assets/|campus/).*)",
      "destination": "/crista/index.html"
    }
  ],
  "headers": [
    {
      "source": "/crista/assets/(.*)-([A-Za-z0-9_-]{8,})\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/crista/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
