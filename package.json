{
  "name": "crista-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "신약 개발 파이프라인 수업 플랫폼 — crista bio-worker 계산 · crista 규칙 사본",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "npm run typecheck -w @crista/shared-types -w @crista/game-rules -w @crista-web/web-contract -w @crista-web/server -w @crista-web/web",
    "test": "npm run test -w @crista-web/web-contract -w @crista-web/server",
    "test:rules": "npm run test -w @crista/game-rules",
    "db:status:local": "node tools/with-local-env.mjs node db/migrate.mjs --status",
    "db:migrate:local": "node tools/with-local-env.mjs node db/migrate.mjs",
    "db:check:local": "node tools/with-local-env.mjs node db/check-boundary.mjs",
    "dev:server": "node tools/with-local-env.mjs npm run dev -w @crista-web/server",
    "teacher:create": "node tools/with-local-env.mjs npm run teacher:create -w @crista-web/server --",
    "e2e:w1": "node tools/with-local-env.mjs node apps/server/scripts/e2e-w1.ts",
    "e2e:parallel": "node tools/with-local-env.mjs node apps/server/scripts/e2e-parallel.ts",
    "e2e:base": "node tools/with-local-env.mjs node apps/server/scripts/e2e-base.ts",
    "e2e:screen": "node tools/with-local-env.mjs node apps/server/scripts/e2e-screen.ts",
    "e2e:clinical": "node tools/with-local-env.mjs node apps/server/scripts/e2e-clinical.ts",
    "e2e:selection": "node tools/with-local-env.mjs node apps/server/scripts/e2e-selection.ts",
    "e2e:patents": "node tools/with-local-env.mjs node apps/server/scripts/e2e-patents.ts",
    "e2e:preclinical": "node tools/with-local-env.mjs node apps/server/scripts/e2e-preclinical.ts",
    "e2e:ind": "node tools/with-local-env.mjs node apps/server/scripts/e2e-ind.ts",
    "e2e:approval": "node tools/with-local-env.mjs node apps/server/scripts/e2e-approval.ts",
    "e2e:learn": "node tools/with-local-env.mjs node apps/server/scripts/e2e-learn.ts",
    "e2e:market": "node tools/with-local-env.mjs node apps/server/scripts/e2e-market.ts",
    "e2e:feed": "node tools/with-local-env.mjs node apps/server/scripts/e2e-feed.ts",
    "e2e:full": "node tools/with-local-env.mjs node apps/server/scripts/e2e-full.ts",
    "e2e:teacher": "node tools/with-local-env.mjs node apps/server/scripts/e2e-teacher.ts",
    "e2e:antibody": "node tools/with-local-env.mjs node apps/server/scripts/e2e-antibody.ts",
    "antibody:seed": "node tools/with-local-env.mjs node apps/server/scripts/antibody-seed.ts",
    "dev:web": "npm run dev -w @crista-web/web",
    "build:web": "npm run build -w @crista-web/web",
    "db:status:hosted": "node tools/with-hosted-env.mjs node db/migrate.mjs --status",
    "db:dry-run:hosted": "node tools/with-hosted-env.mjs node db/migrate.mjs --dry-run",
    "db:check:hosted": "node tools/with-hosted-env.mjs node db/check-boundary.mjs",
    "teacher:create:hosted": "node tools/with-hosted-env.mjs npm run teacher:create -w @crista-web/server --",
    "llm:probe:local": "node tools/with-local-env.mjs node apps/server/scripts/llm-probe.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
