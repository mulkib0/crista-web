     9	import type { FacilityKind, InstitutionKind, InteractOpenMessage, Interactable } from '@crista/shared-types';
    10	import { C2S } from '@crista/shared-types';
    11	import type { PipelineC2SType } from '../ports.ts';
    12	import { clientCtxOf } from './exchange.ts';
    13	import type { RoomMember, RoomScope } from './handlers.ts';
    14	
    15	/** 파이프라인 룸 메시지 10종 — 룸이 이 목록으로 `onMessage` 를 건다. */
    16	export const PIPELINE_MESSAGE_TYPES: readonly PipelineC2SType[] = [
    17	  C2S.PIPELINE_SYNC,
    18	  C2S.PIPELINE_DESK,
    19	  C2S.PROGRAM_DECLARE,
    20	  C2S.PATENT_FILE,
    21	  C2S.PROGRAM_FORMULATE,
    22	  C2S.IND_FILE,
    23	  C2S.PROTOCOL_AMEND,
    24	  C2S.TRIAL_START,
    25	  C2S.FINAL_FILE,
    26	  C2S.PIPELINE_SEEN,
    27	];
    28	
    29	/** 파이프라인 창구가 있는 기관(균형안 §10.1 — 특허청은 시청 안). */
    30	export const PIPELINE_DESKS: readonly InstitutionKind[] = ['city-hall', 'fda', 'hospital'];
    31	
    32	/** 파이프라인 행동을 더하는 사옥 설비 — 표적 탐색실(① 선언) · ADMET실(② 후보 · 제형). */
    33	export const PIPELINE_FACILITIES: readonly FacilityKind[] = ['target', 'admet'];
    34	
    35	export function isPipelineDesk(item: Interactable): boolean {
    36	  return item.kind === 'institution' && item.institution !== undefined && PIPELINE_DESKS.includes(item.institution);
    37	}
    38	
    39	/** `PipelineC2SType` → 파이프라인. 형식 · 장소 · 권한 검증과 실패 `ERROR` 는 파이프라인이 한다. */
    40	export async function handlePipelineMessage(scope: RoomScope, member: RoomMember, type: PipelineC2SType, raw: unknown): Promise<void> {
    41	  if (!scope.pipeline) return;
    42	  await scope.pipeline.handleMessage(clientCtxOf(scope, member), type, raw);
    43	}
    44	
    45	/** 입장 · 재접속 · 공간 이동 뒤 — 회사 구성원이면 파이프라인이 `PIPELINE_STATE` 를 보낸다. 실패는 기록만 한다. */
    46	export async function syncPipelineOnJoin(scope: RoomScope, member: RoomMember): Promise<void> {
    47	  if (!scope.pipeline) return;
    48	  try {
    49	    await scope.pipeline.onJoin(clientCtxOf(scope, member));
    50	  } catch (error) {
    51	    console.warn(`[crista] 파이프라인 입장 동기화 실패(${member.session.user.id}): ${error instanceof Error ? error.message : String(error)}`);
    52	  }
    53	}
    54	
    55	/** 기관 창구 창 — 사거리는 호출자(`handleInteract`)가 이미 확인했다. 창구 종류(`institution`)는 언제나 싣는다. */
    56	export async function buildDeskOpen(scope: RoomScope, member: RoomMember, item: Interactable): Promise<InteractOpenMessage | null> {
    57	  if (!scope.pipeline || !isPipelineDesk(item)) return null;
    58	  const open = await scope.pipeline.deskOpen(clientCtxOf(scope, member), item);
    59	  // v10: 대학병원 창구 — 연례 바이오 학회, 시청 · 특허청 창구 — 통상실시권(License-Out) 장부. 누구나 연다(제출 · 계약은 서비스가 회사 구성원만).
    60	  const extra: InteractOpenMessage['actions'] = [];
    61	  if (item.institution === 'hospital' && scope.symposium) extra.push({ id: 'symposium', label: '연례 바이오 학회', enabled: true });
    62	  if (item.institution === 'city-hall' && scope.license) extra.push({ id: 'license', label: '통상실시권 장부(License-Out)', enabled: true });
    63	  return { ...open, actions: [...open.actions, ...extra], interactableId: item.id, kind: 'institution', institution: item.institution! };
    64	}
    65	
    66	/** 내 사옥 설비 창에 파이프라인 행동을 더한다(표적 탐색실 · ADMET실, 회사 구성원만). 실패하면 설비 창은 그대로 연다. */
    67	export async function withFacilityPipelineActions(
    68	  scope: RoomScope,
    69	  member: RoomMember,
    70	  open: InteractOpenMessage,
    71	): Promise<InteractOpenMessage> {
    72	  const facility = open.facility;
    73	  if (!scope.pipeline || open.readOnly || !facility || !PIPELINE_FACILITIES.includes(facility)) return open;
    74	  const teamId = member.session.user.role === 'student' ? member.session.teamId : null;
    75	  if (!teamId || scope.roomTeamId !== teamId) return open;
    76	  try {
    77	    const extra = await scope.pipeline.facilityActions(clientCtxOf(scope, member), facility);
    78	    return extra.length > 0 ? { ...open, actions: [...open.actions, ...extra] } : open;
    79	  } catch (error) {
    80	    console.warn(`[crista] 설비 창 파이프라인 행동 실패(${teamId} · ${facility}): ${error instanceof Error ? error.message : String(error)}`);
    81	    return open;
    82	  }
    83	}
     1	/**
     2	 * 사용자 통로 등록부 — 룸이 아니라 **userId·teamId·classId 기준**으로 메시지를 보낸다.
     3	 * 사용자가 도시↔사옥 룸을 옮겨도 그 팀의 작업 상태·결과·연구비 상태가 도착한다.
     4	 *
     5	 * 범위(브리프 §4.1)
     6	 * - 팀 단위(`sendToTeam`): 그 팀 구성원 통로에만 간다(타 팀 격리).
     7	 * - 학급 단위(`sendToClass`): 그 학급 월드에 들어온 모두(학생·교사). `CLOCK` · `EVENT_NOTICE` · `WORLD_CHANGED`.
     8	 * - 학급 교사(`sendToClassTeachers`): 그 학급 월드에 들어온 교사만. `GM_STATE`.
     9	 * 구독자마다 `classId`·`role` 을 싣는다 — 다른 학급으로는 아무것도 가지 않는다.
    10	 */
    11	import type { ClassId, TeamId, UserId, UserRole } from '@crista/shared-types';
    12	
    13	export interface Subscriber {
    14	  userId: UserId;
    15	  teamId: TeamId | null;
    16	  /** 이 통로가 붙은 학급 월드. 학생은 세션 학급, 교사는 들어온 학급. 테스트 통로는 null 일 수 있다(학급 전송을 받지 않는다). */
    17	  classId?: ClassId | null;
    18	  role?: UserRole;
    19	  send(type: string, payload: unknown): void;
    20	  /** 이 통로(룸 연결)를 끊는다(v4 — 비밀번호 재발급). 테스트 통로는 생략할 수 있다. */
    21	  disconnect?(code: number, reason: string): void;
    22	}
    23	
    24	export class Hub {
    25	  private readonly byUser = new Map<UserId, Set<Subscriber>>();
    26	
    27	  subscribe(subscriber: Subscriber): () => void {
    28	    let set = this.byUser.get(subscriber.userId);
    29	    if (!set) {
    30	      set = new Set();
    31	      this.byUser.set(subscriber.userId, set);
    32	    }
    33	    set.add(subscriber);
    34	    return () => {
    35	      const current = this.byUser.get(subscriber.userId);
    36	      current?.delete(subscriber);
    37	      if (current && current.size === 0) this.byUser.delete(subscriber.userId);
    38	    };
    39	  }
    40	
    41	  private *all(): Generator<Subscriber> {
    42	    for (const set of this.byUser.values()) yield* set;
    43	  }
    44	
    45	  *team(teamId: TeamId): Generator<Subscriber> {
    46	    for (const subscriber of this.all()) {
    47	      if (subscriber.teamId === teamId) yield subscriber;
    48	    }
    49	  }
    50	
    51	  sendToTeam(teamId: TeamId, type: string, payload: unknown): void {
    52	    for (const subscriber of this.team(teamId)) subscriber.send(type, payload);
    53	  }
    54	
    55	  /** 그 학급 월드의 모두(학생·교사). */
    56	  sendToClass(classId: ClassId, type: string, payload: unknown): void {
    57	    for (const subscriber of this.all()) {
    58	      if (subscriber.classId === classId) subscriber.send(type, payload);
    59	    }
    60	  }
    61	
    62	  /** 그 학급 월드에 들어온 교사만. */
    63	  sendToClassTeachers(classId: ClassId, type: string, payload: unknown): void {
    64	    for (const subscriber of this.all()) {
