```
  async requestExperiment(args: ExperimentRequestArgs): Promise<ExperimentRequestOutcome> {
    if (typeof args.requestId !== 'string' || args.requestId.trim().length === 0) {
      return { ok: false, error: { code: 'bad_request', message: 'requestId 가 필요합니다.', retryable: false } };
    }
    const prepared = prepareInput(args);
    if (!prepared.ok) return { ok: false, error: prepared.error };

    let created: Run;
    try {
      const step = await this.withTeamLock(args.teamId, () => this.createRun(args, prepared));
      if (step.kind !== 'created') return step.outcome;
      created = step.run;
    } catch (error) {
      return { ok: false, error: storeDenial(error) };
    }

    // 첫 접수는 기다린다 — 워커가 400 으로 거절하면 요청자에게 바로 ERROR 를 줄 수 있다(재시도 불가).
    const first = await this.submit(created, 'initial');
    if (first === 'rejected') {
      return { ok: false, error: { ...created.job.view.error! }, job: { ...created.job.view } };
    }
    if (first === 'polling') void this.pollLoop(created);
    return { ok: true, job: { ...created.job.view }, reused: false };
  }
