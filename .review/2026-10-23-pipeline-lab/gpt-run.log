   532	  async handleMessage(ctx: ClientCtx, type: PipelineC2SType, msg: unknown): Promise<void> {
   533	    const raw = obj(msg);
   534	    const requestId = reqIdOf(raw);
   535	    try {
   536	      switch (type) {
   537	        case C2S.PIPELINE_SYNC:
   538	          if (ctx.role === 'student' && ctx.teamId) await this.sendStateTo(ctx);
   539	          return;
   540	        case C2S.PIPELINE_DESK:
   541	          return await this.handleDesk(ctx, raw);
   542	        case C2S.PIPELINE_SEEN:
   543	          return await this.handleSeen(ctx, raw);
   544	        case C2S.PROGRAM_DECLARE:
   545	        case C2S.PATENT_FILE:
   546	        case C2S.PROGRAM_FORMULATE:
   547	        case C2S.IND_FILE:
   548	        case C2S.PROTOCOL_AMEND:
   549	        case C2S.TRIAL_START:
   550	        case C2S.FINAL_FILE: {
   551	          if (!requestId) return this.sendError(ctx, fail('bad_request', 'requestId 가 필요합니다.'));
   552	          const gen = await this.requestGate(ctx);
   553	          if (typeof gen !== 'number') return this.sendError(ctx, gen, requestId);
   554	          let f: Fail | null;
   555	          if (type === C2S.PROGRAM_DECLARE) f = await this.handleDeclare(ctx, raw, requestId, gen);
   556	          else if (type === C2S.PATENT_FILE) f = await this.handlePatent(ctx, raw, requestId, gen);
   557	          else if (type === C2S.PROGRAM_FORMULATE) f = await this.handleFormulate(ctx, raw, requestId, gen);
   558	          else if (type === C2S.PROTOCOL_AMEND) f = await this.handleAmend(ctx, raw, requestId, gen);
   559	          else f = await this.handleStep(ctx, type, raw, requestId, gen);
   560	          if (f) this.sendError(ctx, f, requestId);
   561	          return;
   562	        }
   563	        default:
   564	          this.sendError(ctx, fail('bad_request', '알 수 없는 파이프라인 메시지입니다.'), requestId);
   565	      }
   566	    } catch (error) {
   567	      if (error instanceof StoreUnavailableError) return this.sendError(ctx, fail('store_unavailable', error.message, true), requestId);
   568	      this.logError(`메시지 ${type}`, error);
   569	      this.sendError(ctx, fail('internal', '파이프라인 요청을 처리하지 못했습니다.', true), requestId);
   570	    }
   571	  }

