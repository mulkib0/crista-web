   312	
   313	// ──────────────────────────────── 파이프라인 ────────────────────────────────
   314	
   315	/**
   316	 * 파이프라인 상태(균형안 §10.1 · §10.5). 진행 중 단계가 있으면 `ind_review` · `phaseN` · `final_review`.
   317	 * - `declared` 코드명만 → `formulated` 후보 · 제형 결정(IND 가능) → `ind_review` → `ind_hold`(다시 IND) | `ind_approved`(1상 가능)
   318	 * - `phaseN` → `phaseN_passed`(다음 상 가능, 3상 통과면 최종 신청 가능) | `phaseN_failed`(보류 — 같은 상 다시 · 용량 변경 · 제형 교체)
   319	 * - `final_review` → `approved`(끝) | `final_rejected`(교사 정정으로만 — 최종 다시 신청)
   320	 * - `closed` 재창업으로 닫힘(읽기 전용).
   321	 */
   322	export type ProgramStatus =
   323	  | 'declared'
   324	  | 'formulated'
   325	  | 'ind_review'
   326	  | 'ind_hold'
   327	  | 'ind_approved'
   328	  | 'phase1'
   329	  | 'phase1_passed'
   330	  | 'phase1_failed'
   331	  | 'phase2'
   332	  | 'phase2_passed'
   333	  | 'phase2_failed'
   334	  | 'phase3'
   335	  | 'phase3_passed'
   336	  | 'phase3_failed'
   337	  | 'final_review'
   338	  | 'final_rejected'
   339	  | 'approved'
   340	  | 'closed';
