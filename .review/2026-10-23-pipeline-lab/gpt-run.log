   255	  private async dockingEvidence(classId: ClassId, teamId: TeamId, generation: number): Promise<Map<string, Evidence>> {
   256	    const jobs = (await this.deps.store.listJobsForTeam(teamId)).filter(
   257	      (j) =>
   258	        j.view.teamId === teamId &&
   259	        !j.view.predecessor &&
   260	        j.classId === classId &&
   261	        j.view.stage === 3 &&
   262	        j.view.status === 'succeeded' &&
   263	        j.view.source === 'vina' &&
   264	        !j.view.test &&
   265	        j.view.generation === generation,
   266	    );
   267	    const out = new Map<string, Evidence>();
   268	    if (jobs.length === 0) return out;
   269	    const corrections = new Map<string, number | null>();
   270	    const records = await this.deps.store.listCorrections(classId, { kind: 'experiment', targetIds: jobs.map((j) => j.view.jobId), limit: 1_000 });
   271	    for (const r of records) {
   272	      if (corrections.has(r.targetId)) continue; // 최신이 앞
   273	      const raw = r.after[CORRECTION_AFFINITY_KEY];
   274	      corrections.set(r.targetId, typeof raw === 'number' && Number.isFinite(raw) ? raw : null);
   275	    }
   276	    for (const job of jobs) {
   277	      const canonical = job.artifacts?.canonicalSmiles ?? job.result?.provenance?.canonicalSmiles;
   278	      if (!canonical) continue;
   279	      const affinity = corrections.has(job.view.jobId) ? corrections.get(job.view.jobId)! : bestAffinityOf(job.result);
   280	      if (affinity === null || affinity === undefined) continue;
   281	      const rawLabel = job.params[DOCKING_PARAM.label];
   282	      const label = (typeof rawLabel === 'string' && rawLabel.trim() ? rawLabel.trim() : job.view.inputSummary?.trim() || null)?.slice(0, 40) ?? null;
   283	      const rawTarget = job.params[DOCKING_PARAM.targetId];
   284	      const targetId = typeof rawTarget === 'string' ? rawTarget : job.result?.provenance?.targetId ?? DOCKING_TARGETS[0]!.id;
   285	      const key = targetEvidenceKey(targetId, canonical);
   286	      const prev = out.get(key);
   287	      if (!prev || affinity < prev.affinityKcal) out.set(key, { canonicalSmiles: canonical, label, targetId, affinityKcal: affinity, jobId: job.view.jobId });
   288	    }
   289	    return out;
   290	  }
