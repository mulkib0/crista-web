   511	  /** 회원 · 세대 확인 — 지금 세대를 돌려준다. */
   512	  private async requestGate(ctx: ClientCtx): Promise<number | Fail> {
   513	    const gate = this.memberGate(ctx);
   514	    if (gate) return gate;
   515	    const generation = await this.generationOf(ctx.classId);
   516	    if (generation === null) return fail('bad_request', '알 수 없는 학급입니다.');
   517	    if (ctx.generation !== generation) return fail('stale_generation', '학급이 복원되어 이전 세대의 요청은 반영하지 않습니다 — 화면을 새로 고치세요.');
   518	    return generation;
   519	  }
