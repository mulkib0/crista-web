export async function handleExperimentRequest(scope: RoomScope, member: RoomMember, raw: unknown): Promise<void> {
  if (!isExperimentRequest(raw)) {
    sendError(member.sink, {
      code: 'bad_request',
      message: 'experiment:request 형식이 규격과 다릅니다.',
      retryable: false,
    });
    return;
  }

  const roomTeamId = scope.roomTeamId;
  // v10: 설비 임대 — 다른 회사 사옥의 가동 중인 도킹 · ADMET 설비를 방문 팀(학생)이 실행한다. 사거리 · 등급 · 가동 판정은 주인과 같다.
  const rent = raw.rent === true;
  if (rent) {
    const actorTeam = member.session.teamId;
    if (!scope.license || member.session.user.role !== 'student' || !actorTeam || !roomTeamId || roomTeamId === actorTeam) {
      sendError(member.sink, { code: 'forbidden_team', message: '설비 임대는 다른 회사 사옥의 도킹 · ADMET 설비에서 회사 구성원이 합니다.', requestId: raw.requestId, retryable: false });
      return;
    }
  }
  const permission = checkExperimentPermission({
    map: scope.map,
    at: { x: member.player.x, y: member.player.y },
    scope: { roomTeamId, actorTeamId: rent ? roomTeamId : member.session.teamId },
    interactableId: raw.interactableId,
    tierOf: (kind) => (roomTeamId ? scope.directory.facilityTier(roomTeamId, kind) : 0),
  });
  if (!permission.ok) {
    sendError(member.sink, { ...permission.error, requestId: raw.requestId });
    return;
  }
  if (rent && (!['docking', 'admet'].includes(permission.item.facility) || raw.params?.[DOCKING_PARAM.smiles] === undefined)) {
    sendError(member.sink, { code: 'not_eligible', message: '임대 실행은 도킹 · ADMET 의 실제 계산(분자 입력)만 된다.', requestId: raw.requestId, retryable: false });
    return;
  }
  // 파산은 설비 상태(가동 중지)보다 먼저 알린다 — 재창업으로만 풀린다.
  if (member.session.teamId) {
    try {
      const bankrupt = await scope.teams.economy.spendGate(member.session.teamId, null);
      if (bankrupt) {
        sendError(member.sink, { ...bankrupt, requestId: raw.requestId });
        return;
      }
    } catch (error) {
      sendError(member.sink, storeError(error, raw.requestId));
      return;
    }
  }
  if (roomTeamId && scope.directory.facilityState(roomTeamId, permission.item.facility) === 'idle') {
    sendError(member.sink, {
      code: 'facility_idle',
      message: '가동 중지된 설비입니다 — 재가동한 뒤 실험하세요.',
      requestId: raw.requestId,
      retryable: false,
    });
    return;
  }

  const teamId = member.session.teamId;
  const facility = permission.item.facility;
  const stage = permission.item.stage;
  if (!teamId || stage === undefined) {
    sendError(member.sink, {
      code: 'facility_locked',
      message: '아직 쓸 수 없는 설비입니다.',
      requestId: raw.requestId,
      retryable: false,
    });
    return;
  }

  // 지출 제한(v3) — 파산이면 모든 실험, 유료 계산(Stage 3 · 4 + SMILES)은 일시정지·구조조정·유예 중 막는다.
  // 같은 requestId 재전송(이미 만든 작업)은 막지 않는다 — 결과를 다시 보여 줘야 한다.
  const paidKind: PaidWorkKind | null =
    raw.params?.[DOCKING_PARAM.smiles] !== undefined && (stage === 3 || stage === 4)
      ? stage === 4
        ? 'admet'
        : 'docking'
      : null;
  const paid = paidKind !== null;
