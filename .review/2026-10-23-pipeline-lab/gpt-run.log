   309	  private async facilityOf(teamId: TeamId, kind: FacilityKind): Promise<{ built: boolean; active: boolean; companyActive: boolean }> {
   310	    const eco = await this.deps.store.teamEconomy(teamId);
   334	  private pickEvidence(all: ReadonlyMap<string, Evidence>, smiles: string, wantTargetId: string | null, programTargetId: string | null): Evidence | null {
   335	    if (wantTargetId) return all.get(targetEvidenceKey(wantTargetId, smiles)) ?? null;
   336	    if (programTargetId) {
   337	      const onProgram = all.get(targetEvidenceKey(programTargetId, smiles));
   338	      if (onProgram) return onProgram;
   339	    }
   340	    const mine = [...all.values()].filter((e) => e.canonicalSmiles === smiles);
   341	    return mine.sort((a, b) => a.affinityKcal - b.affinityKcal || a.targetId.localeCompare(b.targetId))[0] ?? null;
   342	  }
   343	
   344	  /** 그 표적의 결정 리간드 재도킹 기준값(결합력 정규화, v11). 모르는 표적이면 규칙의 기본값을 쓴다. */
   345	  private referenceKcalOf(targetId: string): number | undefined {
   346	    return DOCKING_TARGETS.find((t) => t.id === targetId)?.referenceKcal;
   347	  }
   348	
   349	  /**
   350	   * ① 선언의 질환 · 표적 → 확정 표적(v11). 질환만 주면 기본 짝, 표적만 주면 그대로, 둘 다면 짝이 맞아야 한다.
   351	   * 둘 다 없으면 지금 표적을 유지하고(옛 클라이언트 호환), 새 파이프라인이면 알츠하이머 · AChE 가 기본이다.
   352	   */
   353	  private declaredTarget(raw: Record<string, unknown>, current: string | null): { targetId: string } | Fail {
   354	    const rawDisease = raw.diseaseId;
   355	    const rawTarget = raw.targetId;
   356	    if (rawDisease !== undefined && (typeof rawDisease !== 'string' || !(rawDisease in DISEASE_TO_TARGET))) {
   357	      return fail('invalid_input', `모르는 질환입니다 — 질환은 ${DISEASE_IDS.map((id) => `${DISEASE_LABEL[id]}(${id})`).join(' · ')} 중 하나입니다.`);
   358	    }
   359	    if (rawTarget !== undefined && (typeof rawTarget !== 'string' || !DOCKING_TARGETS.some((t) => t.id === rawTarget))) {
   360	      return fail('invalid_input', `모르는 표적입니다 — 표적은 ${DOCKING_TARGETS.map((t) => t.id).join(' · ')} 중 하나입니다.`);
   361	    }
   362	    const byDisease = typeof rawDisease === 'string' ? DISEASE_TO_TARGET[rawDisease as DiseaseId] : null;
   363	    if (typeof rawTarget === 'string' && byDisease && rawTarget !== byDisease) {
   364	      const want = DOCKING_TARGETS.find((t) => t.id === byDisease);
   365	      return fail(
   366	        'invalid_input',
   367	        `${DISEASE_LABEL[rawDisease as DiseaseId]} 의 결정구조 표적은 ${want?.label ?? byDisease}(${want?.gene ?? ''} · PDB ${want?.pdbId ?? ''}) 입니다 — 질환과 표적이 맞지 않습니다.`,
   368	      );
   369	    }
   370	    return { targetId: (typeof rawTarget === 'string' ? rawTarget : null) ?? byDisease ?? current ?? DOCKING_TARGETS[0]!.id };
   384	  private async buildTeamState(classId: ClassId, teamId: TeamId, generation: number, rows?: ClassPipelineRows) {
   385	    const data = rows ?? (await this.store.loadClass(classId, generation));
   386	    const labels = await this.teamLabels(classId);
   387	    const patentsById = new Map(data.patents.map((p) => [p.id, p]));
   388	    const program = data.programs.find((p) => p.teamId === teamId) ?? null;
   389	    const teamSteps = data.steps.filter((s) => s.teamId === teamId);
   390	    // v10: 통상실시권으로 취득한 특허도 후보로 고를 수 있게 함께 싣는다(소유 회사 표시는 patentView 의 티커).
   391	    const licensed = await this.licensed(classId, teamId);
   392	    const patents = data.patents.filter((p) => p.teamId === teamId || licensed.has(p.id)).slice().reverse();
   393	    const evidence = await this.dockingEvidence(classId, teamId, generation);
   394	    const active = data.patents.filter((p) => p.status === 'active');
   395	    // v11 — 표적 × 분자마다 한 줄. 지금 파이프라인 표적의 근거를 앞에 두고, 그 안에서 결합이 센 순서.
   396	    const focusTarget = program?.targetId ?? null;
   397	    const candidates: PatentCandidateView[] = [...evidence.values()]
   398	      .sort(
   399	        (a, b) =>
   400	          Number(b.targetId === focusTarget) - Number(a.targetId === focusTarget) ||
   401	          a.targetId.localeCompare(b.targetId) ||
   402	          a.affinityKcal - b.affinityKcal ||
   403	          a.canonicalSmiles.localeCompare(b.canonicalSmiles),
   404	      )
   405	      .map((e) => {
   406	        const same = active.filter((p) => p.canonicalSmiles === e.canonicalSmiles || p.flatSmiles === e.canonicalSmiles);
   407	        const ours = same.some((p) => p.teamId === teamId);
   408	        const other = same.find((p) => p.teamId !== teamId) ?? null;
   409	        return {
   410	          canonicalSmiles: e.canonicalSmiles,
   411	          label: e.label,
   412	          targetId: e.targetId,
   413	          affinityKcal: e.affinityKcal,
   414	          jobId: e.jobId,
   415	          conflict: other ? { ticker: labelOf(labels, other.teamId).ticker, patentId: other.id } : null,
   416	          ours,
   417	        };
   418	      });
   419	    let previous: PipelineStateMessage['previous'] = null;
   420	    const lineage = await this.deps.store.lineageTeamIds(teamId);
   421	    for (const prevId of lineage.filter((id) => id !== teamId).reverse()) {
   422	      const prevProgram = data.programs.find((p) => p.teamId === prevId);
   423	      if (!prevProgram) continue;
   424	      previous = {
   425	        program: programView(prevProgram, patentsById),
   426	        steps: data.steps.filter((s) => s.teamId === prevId).slice().reverse().map(stepView),
   427	      };
   428	      break;
   429	    }
   430	    const base: Omit<PipelineStateMessage, 'unseenStepIds'> = {
   431	      classId,
   432	      teamId,
   433	      generation,
   434	      program: program ? programView(program, patentsById) : null,
   435	      steps: teamSteps.slice().reverse().map(stepView),
   436	      patents: patents.map((p) => patentView(p, labelOf(labels, p.teamId))),
   437	      candidates,
   438	      previous,
   439	    };
   440	    const decided = teamSteps
   441	      .filter((s) => s.status === 'passed' || s.status === 'failed')
   442	      .sort((a, b) => (a.decidedAtMs ?? 0) - (b.decidedAtMs ?? 0) || a.startedAtMs - b.startedAtMs)
   443	      .map((s) => s.id);
   444	    return { base, decided };
   445	  }
   485	  private locate(ctx: ClientCtx, interactableId: unknown, want: { institution?: Institution | 'any-desk'; facility?: 'target' | 'admet' }): Interactable | Fail {
   486	    const item = findInteractable(ctx.map, interactableId);
   487	    if (!item) return fail('unknown_interactable', '알 수 없는 상호작용 지점입니다.');
   488	    if (want.institution) {
   489	      const ok =
   490	        item.kind === 'institution' &&
   491	        item.institution !== undefined &&
   492	        (want.institution === 'any-desk' ? (DESK_INSTITUTIONS as readonly string[]).includes(item.institution) : item.institution === want.institution);
   493	      if (!ok) return fail('unknown_interactable', want.institution === 'any-desk' ? '창구가 아닌 지점입니다.' : `이 신청은 ${INSTITUTION_LABEL[want.institution]} 창구에서만 할 수 있습니다.`);
   494	    }
   495	    if (want.facility) {
   496	      if (item.kind !== 'facility' || item.facility !== want.facility) {
   497	        return fail('unknown_interactable', want.facility === 'target' ? '코드명 · 기전 선언은 내 사옥 표적 탐색실에서 합니다.' : '후보 · 제형 결정은 내 사옥 ADMET실에서 합니다.');
   498	      }
   499	      if (ctx.visitor || ctx.hqTeamId === null || ctx.hqTeamId !== ctx.teamId) return fail('forbidden_team', '내 회사 사옥의 설비에서만 할 수 있습니다.');
   500	    }
   501	    if (!withinRange(ctx.map, { x: ctx.x, y: ctx.y }, item.id)) return fail('out_of_range', `${item.label}에 더 가까이 가서 다시 시도하세요.`, true);
   502	    return item;
   503	  }
