export function StepResultSheet({
  step,
  program,
  remaining,
  onClose,
  onNext,
  initialRedesignOpen = false,
  bounty = null,
  initialBountyOpen = false,
}: StepResultSheetProps) {
  const passed = effectivePassed(step);
  // 정정되면 서버는 status 를 정정 결과로 바꾸고 원본은 judgement.passed 에 남긴다(pipeline.ts `correction` 주석).
  const originalPassed = step.judgement ? step.judgement.passed : step.status === 'passed';
  const failed = passed === false;
  const [redesign, setRedesign] = useState(initialRedesignOpen);
  const [analysis, setAnalysis] = useState(initialBountyOpen);
  const bountyTab = failed && bounty !== null && step.kind !== 'final';
  const j = step.judgement;

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') onClose();
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [onClose]);

  const stampFrame = passed ? (step.kind === 'ind' ? 'stamp/ind-approved' : step.kind === 'final' ? 'stamp/nda-approved' : null) : failed ? 'stamp/crl-hold' : null;
  const stampLabel = passed ? (step.kind === 'ind' ? 'IND 승인' : '최종 허가') : step.kind === 'ind' ? 'IND 보류' : step.kind === 'final' ? '허가 거절' : '보류(CRL)';
  const title = step.correction ? `${PIPELINE_STEP_LABEL[step.kind]} ${passed ? '통과' : '보류'} (교사 정정)` : stepTitle(step);

  return (
    <div style={{ position: 'relative', display: 'flex', alignItems: 'flex-start' }}>
      <div
        role="dialog"
        aria-modal="true"
        aria-label={`단계 결과 — ${title}`}
        className="nb-sheet nb-enter nb-bind nb-step-result"
        style={{ ...{ '--nb-panel-px': 'var(--gap-4)', '--nb-panel-py': 'var(--gap-3)' },
          position: 'relative',
          width: 'min(760px, calc(100vw - 96px))',
          maxHeight: 'calc(100vh - 120px)',
          overflow: 'auto',
          padding: 'var(--gap-3) var(--gap-4)',
          display: 'grid',
          gap: 'var(--gap-2)',
          boxSizing: 'border-box',
        }}
      >
      <header className="nb-tb">
        <h2 className="nb-tb-title">{title}</h2>
        <button type="button" className="nb-tb-x" aria-label="단계 결과 닫기" onClick={onClose}>✕</button>
      </header>

        {step.correction ? (
          <section aria-label="교사 판정 정정" className="nb-teacher" style={{ ...{ '--nb-panel-px': '10px', '--nb-panel-py': '4px' }, padding: '4px 10px', display: 'grid', gridTemplateColumns: 'auto 1fr 1fr', gap: '2px 12px', alignItems: 'baseline', fontSize: 'var(--fs-12)', position: 'relative' }}>
