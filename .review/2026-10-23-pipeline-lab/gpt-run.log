  const myPatents = state?.patents ?? [];
  const program = state?.program ?? null;
  const blocked = paidBlockedOf(team, (action?.costCents ?? 0) > 0);

  const fileFor = (c: PatentCandidateView) => {
    const label = (drafts['patent.label'] ?? c.label ?? '').trim();
    // v11 — 어느 표적의 도킹 근거로 내는지 함께 보낸다(같은 분자를 여러 표적에 도킹했을 수 있다).
    form.submit(`${c.targetId}|${c.canonicalSmiles}|${label}`, (requestId) =>
      sender.patent({
        requestId,
        interactableId: open.interactableId,
        canonicalSmiles: c.canonicalSmiles,
        targetId: c.targetId as TargetId,
        ...(label ? { label } : {}),
      }),
    );
  };

  /** 표 한 줄의 식별자 — 같은 분자라도 표적이 다르면 다른 줄이다(v11). */
  const rowKey = (c: PatentCandidateView) => targetEvidenceKey(c.targetId, c.canonicalSmiles);
  const geneOf = (targetId: string) => DOCKING_TARGETS.find((t) => t.id === targetId)?.gene ?? targetId;

  return (
    <>
      {action ? (
        <FormSection title="출원할 수 있는 분자" note="이번 세대 실제 도킹(vina) 성공 결과의 분자만 — 같은 물질(입체 정보를 뺀 정규 SMILES)의 유효 특허가 학급에 있으면 출원할 수 없다">
          <ActionNote action={action} />
          {blocked ? <PaidBlockedNote /> : null}
          {candidates.length ? (
