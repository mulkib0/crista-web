3. compute_properties · function  [symbol]
   apps/bio-worker/app/properties.py:L81-L113
   def compute_properties(raw: object) -> MoleculeProperties

```
def compute_properties(raw: object) -> MoleculeProperties:
    """SMILES 하나 → 물성. 계산할 수 없는 입력은 `InvalidDockingInput`(400), RDKit 없음은 `PropertiesUnavailable`(503)."""
    try:
        rd = _rdkit()
    except Exception as exc:  # noqa: BLE001
        raise PropertiesUnavailable(f"물성 계산 도구(RDKit)를 불러오지 못했습니다: {type(exc).__name__}") from exc

    ligand = rd["validate_smiles"](raw)  # 도킹과 같은 검증 · 정규화(주 조각)
    mol = ligand.mol
    flat = rd["flat_canonical"](ligand.canonical_smiles)
    if flat is None:  # pragma: no cover — 방금 RDKit 가 쓴 정규 SMILES 는 다시 읽힌다
        raise InvalidDockingInput("정규화한 SMILES 를 다시 읽지 못했습니다.")

    Descriptors, Crippen, Lipinski = rd["Descriptors"], rd["Crippen"], rd["Lipinski"]
    rdm, QED = rd["rdMolDescriptors"], rd["QED"]
    alerts: list[StructuralAlertId] = [
        kind for kind, pats in rd["alerts"].items() if any(mol.HasSubstructMatch(p) for p in pats)
    ]
    return MoleculeProperties(
        canonicalSmiles=ligand.canonical_smiles,
        flatSmiles=flat,
        mw=_round(Descriptors.MolWt(mol), 1),
        clogp=_round(Crippen.MolLogP(mol), 2),
        tpsa=_round(rdm.CalcTPSA(mol), 1),
        hbd=Lipinski.NumHDonors(mol),
        hba=Lipinski.NumHAcceptors(mol),
        rotb=Lipinski.NumRotatableBonds(mol),
        aromaticRings=rdm.CalcNumAromaticRings(mol),
        qed=_round(QED.qed(mol), 2),
        basicAmines=len(mol.GetSubstructMatches(rd["basic"])),
        alerts=alerts,
        engine=f"RDKit {rd['version']}",
    )
```

4. clean_input · function  [symbol]
   apps/bio-worker/app/llm/prompts.py:L88-L92
   def clean_input(text: str, limit: int) -> str

```
def clean_input(text: str, limit: int) -> str:
    """사람이 쓴 글을 프롬프트에 넣기 전에 — 제어 · 보이지 않는 문자 제거, 공백 정리, 길이 상한."""
    text = _CONTROL.sub("", text)
    text = _SPACE.sub(" ", text).strip()
    return text[:limit]
```

