export class PipelineService implements PipelinePort {
  readonly store: PipelineStore;
  private readonly worker: PropertiesClient;
  private readonly running = new Map<ClassId, { generation: number; entries: RunningEntry[] }>();
  private readonly locks = new Map<ClassId, Promise<unknown>>();
  private readonly now: () => number;

  private readonly deps: PipelineDeps;

  constructor(deps: PipelineDeps, extras: PipelineServiceExtras = {}) {
    this.deps = deps;
    this.store = extras.pipelineStore ?? createPipelineStore(deps.storeKind, deps.pool);
    this.worker = extras.worker ?? new HttpPropertiesClient(deps.workerUrl);
    this.now = deps.now ?? Date.now;
  }

  // ─────────────────────────────── 수명 ───────────────────────────────

  async start(): Promise<void> {
    const classes = await this.deps.store.listActiveClasses();
    for (const info of classes) {
      try {
        await this.loadIndex(info.id, info.generation);
      } catch (error) {
        console.warn(`[crista] 파이프라인 색인 읽기 실패(${info.id}): ${error instanceof Error ? error.message : String(error)}`);
      }
    }
  }

  stop(): void {
    // 타이머 없음 — 시간은 W-server 의 advance 가 민다.
  }

  private async loadIndex(classId: ClassId, generation: number): Promise<void> {
    const steps = await this.store.listRunning(classId, generation);
    this.running.set(classId, {
      generation,
      entries: steps.map((s) => ({ stepId: s.id, teamId: s.teamId, endGameDay: s.endGameDay, startedAtMs: s.startedAtMs })),
    });
  }

  private indexAdd(classId: ClassId, generation: number, step: StepRecord): void {
    let idx = this.running.get(classId);
    if (!idx || idx.generation !== generation) {
      idx = { generation, entries: [] };
      this.running.set(classId, idx);
    }
    idx.entries = idx.entries.filter((e) => e.stepId !== step.id);
    idx.entries.push({ stepId: step.id, teamId: step.teamId, endGameDay: step.endGameDay, startedAtMs: step.startedAtMs });
  }

  private indexRemove(classId: ClassId, stepIds: readonly string[]): void {
    const idx = this.running.get(classId);
    if (!idx) return;
    const drop = new Set(stepIds);
    idx.entries = idx.entries.filter((e) => !drop.has(e.stepId));
  }

  /** 진행 중 단계 색인(테스트 · 진단용 사본). */
  runningIndex(classId: ClassId): RunningEntry[] {
    return [...(this.running.get(classId)?.entries ?? [])].map((e) => ({ ...e }));
  }

  private withLock<T>(classId: ClassId, run: () => Promise<T>): Promise<T> {
    const prev = this.locks.get(classId) ?? Promise.resolve();
    const next = prev.then(run, run);
    const tail = next.catch(() => undefined);
    this.locks.set(classId, tail);
    void tail.then(() => {
      if (this.locks.get(classId) === tail) this.locks.delete(classId);
    });
    return next;
  }

  // ─────────────────────────────── 공용 읽기 ───────────────────────────────

  private async generationOf(classId: ClassId): Promise<number | null> {
    return (await this.deps.store.classInfo(classId))?.generation ?? null;
  }

