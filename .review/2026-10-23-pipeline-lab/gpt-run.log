export function InteractModal({ open, visitor, onClose, onSubmit, onBuild, pipeline }: InteractModalProps) {
  const drafts = useInteractStore((s) => s.drafts);
  const setDraft = useInteractStore((s) => s.setDraft);
  const submitting = useInteractStore((s) => s.submitting);
  const setSubmitting = useInteractStore((s) => s.setSubmitting);
  const setError = useInteractStore((s) => s.setError);
  const formError = useInteractStore((s) => s.errors[open.interactableId]);
  const takeRequestId = useJobsStore((s) => s.takeRequestId);
  const teamState = useTeamStore((s) => s.state);
  const [triedSubmit, setTriedSubmit] = useState(false);
  /** 위기 이상에서 유료 실험을 누르면 먼저 지출 후 잔액을 보인다. */
  const [confirmSpend, setConfirmSpend] = useState(false);

  const stage: Stage = open.stage ?? 1;
  const docking = stage === 3;
  /** Stage 4 는 내 유효 특허에서 분자를 고른다 — 자유 입력 칸이 없다. */
  const admet = stage === 4;
  const fields = docking || admet ? [] : STAGE_FIELDS[stage];
  const draft = drafts[open.interactableId] ?? {};

  const readOnly = open.readOnly || visitor;
  /** v10: 다른 회사 사옥의 가동 중인 도킹 · ADMET 설비 — 방문 학생의 '임대 실행'(작업비 + 임대료). 실험 폼을 그대로 쓴다. */
  const rentAction = visitor ? open.actions.find((a) => a.id === 'rent') : undefined;
  const experiment = rentAction ?? open.actions.find((a) => a.id === 'experiment');
  /** 실험 폼의 잠금 — 임대 실행이면 방문자라도 연다(서버가 사거리 · 가동 · 상한 · 순환을 다시 본다). */
  const formReadOnly = rentAction ? false : readOnly;

  const admetPatents = useMemo(
    () => (pipeline?.state?.patents ?? []).filter((p) => p.status === 'active'),
    [pipeline?.state?.patents],
  );
  const candidatePatentId = pipeline?.state?.program?.candidate?.patentId;
  const admetPatentId =
    draft[ADMET_DRAFT_KEY] && admetPatents.some((p) => p.id === draft[ADMET_DRAFT_KEY])
      ? draft[ADMET_DRAFT_KEY]
      : candidatePatentId && admetPatents.some((p) => p.id === candidatePatentId)
        ? candidatePatentId
        : admetPatents[0]?.id ?? '';
  const admetPatent = admet ? admetPatents.find((p) => p.id === admetPatentId) : undefined;

  /** 유료는 실제 계산 요청뿐이다 — Stage 4 에서 고를 특허가 없으면 분자 없이 보내 고정 결과가 오고 서버도 과금하지 않는다. */
  const paid = (experiment?.costCents ?? 0) > 0 && (!admet || admetPatent !== undefined);
  /** 구조조정·유예로 막힌 유료 연구 — 서버도 `restructure_blocked` 로 거절한다. 무료 실험은 열려 있다. */
  const paidBlocked = paid && (teamState?.cash.blocked.includes('paidWork') ?? false);
  const canSubmit = !formReadOnly && experiment?.enabled === true && !submitting && !paidBlocked;

  // Esc 로 닫는다.
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') onClose();
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [onClose]);

  /** v11 — 우리 파이프라인이 겨냥하는 표적. Stage 2 기준 표적 · Stage 3 기본 표적이 이 값을 따라간다. */
  const programTargetId = pipeline?.state?.program?.targetId ?? null;

  const filled = useMemo(() => {
    const next: Record<string, string> = {};
