   505	  private memberGate(ctx: ClientCtx): Fail | null {
   506	    if (ctx.role !== 'student') return fail('forbidden_role', '신청은 회사 구성원(학생)만 할 수 있습니다.');
   507	    if (!ctx.teamId) return fail('forbidden_team', '소속 회사가 없습니다.');
   508	    return null;
   509	  }
