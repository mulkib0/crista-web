```
    async def molecule_properties(http: Request) -> JSONResponse:
        raw = await http.body()
        if len(raw) > PROPERTIES_BODY_MAX_BYTES:
            return _error("invalid_input", "요청 본문이 너무 큽니다. 분자 하나의 SMILES 만 보내세요.", 400)
        try:
            body = MoleculePropertiesRequest.model_validate(json.loads(raw))
        except (ValueError, ValidationError):  # JSON 이 아니거나 { smiles: string } 이 아니다.
            return _error("invalid_input", "요청 형식이 규격과 다릅니다: { smiles: string } 하나를 보내세요.", 400)
        try:
            # 수 ms 지만 RDKit 는 GIL 을 오래 잡을 수 있어 이벤트 루프 밖에서 계산한다.
            props = await asyncio.to_thread(compute_properties, body.smiles)
        except InvalidDockingInput as exc:
            return _error("invalid_input", str(exc), 400)
        except PropertiesUnavailable as exc:
            logger.warning("물성 계산 불가 — %s", exc)
            return _error("worker_unavailable", str(exc), 503)
        return _json(MoleculePropertiesOk(properties=props))
```

