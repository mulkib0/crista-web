   292	  /** (v10) 통상실시권으로 취득한 특허 id — 없거나 실패하면 빈 집합(내 특허만). */
   293	  private async licensed(classId: ClassId, teamId: TeamId): Promise<ReadonlySet<string>> {
   294	    try {
   295	      return (await this.deps.licensedPatentIds?.(classId, teamId)) ?? new Set();
   296	    } catch (error) {
   297	      this.logError('통상실시권 읽기', error);
   298	      return new Set();
   299	    }
   300	  }
