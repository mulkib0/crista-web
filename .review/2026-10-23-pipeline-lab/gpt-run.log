                      <td className="nb-num" style={{ whiteSpace: 'nowrap' }}>
                        {geneOf(c.targetId)}
                        {program && c.targetId !== program.targetId ? (
                          <span className="nb-label" style={{ color: 'var(--ink-faint)' }}> · 다른 표적</span>
                        ) : null}
                      </td>
                      <td><Smiles text={c.canonicalSmiles} /></td>
                      <td style={{ textAlign: 'right', whiteSpace: 'nowrap' }}>{formatKcal(c.affinityKcal)}</td>
