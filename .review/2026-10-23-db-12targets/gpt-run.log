#: v11 이전에 만들어 넣었던 합성 지표 — 실측이 아니라서 걷어낸다(오프라인 재계산 때).
SYNTHETIC_TARGET_FIELDS = ("log2fc", "negLog10P", "plddt", "pocketVolumeA3")


def strip_synthetic_target_fields() -> int:
    """`disease_targets.json` 에서 지어낸 수치 칸을 지운다. 지운 칸 수를 돌려준다(네트워크를 쓰지 않는다)."""
    path = DATASETS_DIR / "disease_targets.json"
    doc = json.loads(path.read_text())
    removed = 0
    for record in (doc.get("diseases") or {}).values():
        for target in record.get("targets") or []:
            for key in SYNTHETIC_TARGET_FIELDS:
                if key in target:
                    del target[key]
                    removed += 1
    if removed:
        path.write_text(json.dumps(doc, ensure_ascii=False, indent=2) + "\n")
    return removed


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    parser.add_argument(
        "--offline",
        action="store_true",
        help="네트워크를 쓰지 않고 이미 받은 분자에서 물성 · 구조 경고 · 사전 도킹 값만 다시 계산한다",
    )
    args = parser.parse_args(argv)
    DATASETS_DIR.mkdir(parents=True, exist_ok=True)
    refs = target_references()

    if args.offline:
        sys.path.insert(0, str(ROOT / "scripts"))
        from prescreen_library import load_progress  # noqa: PLC0415 — 스크립트끼리의 지역 의존

        prescreen = load_progress()
        doc = json.loads((DATASETS_DIR / "compound_library.json").read_text())
        updated = recompute_derived(doc, prescreen, refs)
        (DATASETS_DIR / "compound_library.json").write_text(json.dumps(updated, ensure_ascii=False, indent=2) + "\n")
        print(f"· 다시 계산: 화합물 {updated['totalCount']}종 · 사전 도킹 기록 {len(prescreen)}건")
        stripped = strip_synthetic_target_fields()
        if stripped:
            print(f"· 합성 지표 제거: 질환-표적 레코드에서 {stripped}칸(log2fc · negLog10P · plddt · pocketVolumeA3)")
    else:
        targets_doc = fetch_open_targets(size_per_disease=120)
        (DATASETS_DIR / "disease_targets.json").write_text(
            json.dumps(targets_doc, ensure_ascii=False, indent=2) + "\n"
        )
        compounds_doc = fetch_chembl_library(target_total=220)
        (DATASETS_DIR / "compound_library.json").write_text(
            json.dumps(compounds_doc, ensure_ascii=False, indent=2) + "\n"
        )
        print("· 수집 완료 — 이어서 scripts/prescreen_library.py 로 표적별 사전 도킹을 돌리고 `--offline` 로 다시 계산하세요")

    manifest = write_manifest(refs)
    print(f"· 매니페스트: {(DATASETS_DIR / 'manifest.json').relative_to(ROOT)}")
    for name, info in manifest["files"].items():
        print(f"  {name}  {info['records']}건  sha256 {info['sha256'][:16]}…")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

