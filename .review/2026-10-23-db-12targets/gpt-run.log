# RDKit 의 파싱 경고를 표준 오류에 뿌리지 않는다 — 사유는 우리가 한국어로 돌려준다.
RDLogger.DisableLog("rdApp.*")

# protocol.ts `SMILES_MAX_LENGTH`.
SMILES_MAX_LENGTH = 200
# Vina(AD4 원자형)와 MMFF94 가 모두 다루는 원소 — 유기 저분자 의약품의 원소 집합.
ALLOWED_ELEMENTS = frozenset({"C", "H", "N", "O", "S", "P", "F", "Cl", "Br", "I"})
MIN_HEAVY_ATOMS = 5
MAX_HEAVY_ATOMS = 60
MAX_MOLWT = 700.0
MAX_ROTATABLE_BONDS = 15
# 반대이온으로 보고 떼어 낼 수 있는 조각 — 중원자 12개 이하이면서 가장 큰 조각의 절반 이하.
# (염산염 Cl⁻ · 메실산 5 · 말레산/푸마르산 8 · 타르타르산 10 · 토실산 11 은 떼고,
#  비슷한 크기의 두 분자를 섞은 혼합물은 거절한다.)
COUNTERION_MAX_HEAVY = 12
COUNTERION_MAX_RATIO = 0.5


@dataclass
class ValidatedLigand:
    """검증을 통과한 입력. `mol` 은 수소 없는 주 조각."""

    input_smiles: str
    canonical_smiles: str  # 입체 포함 RDKit 정규 SMILES — 캐시 키·provenance
    flat_smiles: str  # 입체 무시 정규 SMILES — 결정 리간드와 같은 분자인지 비교
    mol: Chem.Mol
    heavy_atoms: int
    mol_weight: float
    rotatable_bonds: int
    # 입체가 지정되지 않은 사면체 입체 중심 수 — ETKDG 가 seed 에 따라 하나를 고른다(결정적이지만 임의).
    unassigned_stereocenters: int = 0
    removed_fragments: list[str] = field(default_factory=list)


def _canonical(mol: Chem.Mol, *, isomeric: bool) -> str:
    return Chem.MolToSmiles(mol, isomericSmiles=isomeric)


def flat_canonical(smiles: str) -> str | None:
    """입체를 무시한 정규 SMILES. 읽지 못하면 None."""
    mol = Chem.MolFromSmiles(smiles)
    return None if mol is None else _canonical(mol, isomeric=False)


def count_unassigned_stereocenters(mol: Chem.Mol) -> int:
    """입체가 지정되지 않은 사면체 입체 중심 수(RDKit 새 입체 인식)."""
    centers = Chem.FindMolChiralCenters(mol, includeUnassigned=True, useLegacyImplementation=False)
    return sum(1 for _, label in centers if label == "?")


def validate_smiles(raw: object) -> ValidatedLigand:
    if not isinstance(raw, str) or not raw.strip():
        raise InvalidDockingInput("분자 구조(SMILES)를 입력하세요.")
    smiles = raw.strip()
    if len(smiles) > SMILES_MAX_LENGTH:
        raise InvalidDockingInput(f"SMILES 가 너무 깁니다({len(smiles)}자). {SMILES_MAX_LENGTH}자 이하로 줄이세요.")
    if any(ch.isspace() for ch in smiles):
        raise InvalidDockingInput("SMILES 안에 공백이 있습니다. 분자 하나를 공백 없이 입력하세요.")

    mol = Chem.MolFromSmiles(smiles)
    if mol is None:
        raise InvalidDockingInput(
            "SMILES 를 분자로 읽을 수 없습니다. 괄호·고리 번호·원자 기호와 원자가(예: 탄소 결합 4개)를 확인하세요."
        )
    if mol.GetNumAtoms() == 0:
        raise InvalidDockingInput("SMILES 에 원자가 없습니다.")

    # ── 여러 조각: 작은 반대이온은 떼고, 큰 조각이 둘 이상이면 거절 ──
    frags = sorted(
        Chem.GetMolFrags(mol, asMols=True, sanitizeFrags=True),
        key=lambda f: (f.GetNumHeavyAtoms(), _canonical(f, isomeric=True)),
        reverse=True,
    )
    main = frags[0]
    removed: list[str] = []
    for frag in frags[1:]:
        n = frag.GetNumHeavyAtoms()
        if n > COUNTERION_MAX_HEAVY or n > main.GetNumHeavyAtoms() * COUNTERION_MAX_RATIO:
            raise InvalidDockingInput(
                "점(.)으로 나뉜 큰 분자가 둘 이상입니다. 도킹은 한 번에 분자 하나만 계산합니다 — 하나만 남기세요."
            )
        removed.append(_canonical(frag, isomeric=True))

    # ── 원소 ──
    bad = sorted({a.GetSymbol() for a in main.GetAtoms() if a.GetSymbol() not in ALLOWED_ELEMENTS})
    if bad:
        shown = ", ".join("*(와일드카드)" if s == "*" else s for s in bad)
        raise InvalidDockingInput(
            f"지원하지 않는 원소가 있습니다: {shown}. C·H·N·O·S·P·F·Cl·Br·I 로 된 유기 분자만 계산합니다."
        )
    if not any(a.GetSymbol() == "C" for a in main.GetAtoms()):
        raise InvalidDockingInput("탄소가 없는 분자는 유기 저분자 도킹 대상이 아닙니다.")
    if any(a.GetNumRadicalElectrons() for a in main.GetAtoms()):
        raise InvalidDockingInput("홀전자(라디칼)가 있는 구조입니다. 수소 수와 전하를 확인하세요.")

    # ── 크기 ──
    heavy = main.GetNumHeavyAtoms()
    if heavy < MIN_HEAVY_ATOMS:
        raise InvalidDockingInput(
            f"분자가 너무 작습니다(수소 외 원자 {heavy}개). {MIN_HEAVY_ATOMS}개 이상인 분자를 입력하세요."
        )
    if heavy > MAX_HEAVY_ATOMS:
        raise InvalidDockingInput(
            f"분자가 너무 큽니다(수소 외 원자 {heavy}개). {MAX_HEAVY_ATOMS}개 이하인 저분자만 도킹합니다."
        )
    mw = Descriptors.MolWt(main)
    if mw > MAX_MOLWT:
        raise InvalidDockingInput(f"분자량이 너무 큽니다({mw:.0f} g/mol). {MAX_MOLWT:.0f} g/mol 이하만 도킹합니다.")
    rot = rdMolDescriptors.CalcNumRotatableBonds(main)
    if rot > MAX_ROTATABLE_BONDS:
        raise InvalidDockingInput(
            f"회전 가능한 결합이 너무 많습니다({rot}개). {MAX_ROTATABLE_BONDS}개를 넘으면 도킹 탐색을 믿기 어렵습니다."
        )

    return ValidatedLigand(
        input_smiles=smiles,
        canonical_smiles=_canonical(main, isomeric=True),
        flat_smiles=_canonical(main, isomeric=False),
        mol=main,
        heavy_atoms=heavy,
        mol_weight=round(mw, 2),
        rotatable_bonds=rot,
        unassigned_stereocenters=count_unassigned_stereocenters(main),
        removed_fragments=removed,
    )
"""
AutoDock Vina 공식 실행 파일을 asyncio 서브프로세스로 돌린다 — 이벤트 루프를 막지 않는다.

진행률: Vina 는 `0%   10 … 100%` 눈금 아래 `|----|` 줄을 찍은 뒤 몬테카를로 탐색이 진행될 때마다
`*` 를 하나씩(전부 51개) 찍고 그때마다 flush 한다. 파이프로 읽어도 `*` 가 한 글자씩 실시간으로
도착함을 확인했다(2026-10-21, v1.2.7 mac_aarch64, 약 0.1초 간격) — pty·시간 추정이 필요 없다.

프로세스는 어떤 경로로 끝나든(정상·취소·제한 시간) `finally` 에서 반드시 죽이고 거둔다.
"""

from __future__ import annotations

import asyncio
import hashlib
import logging
import re
import subprocess
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

from ..config import VINA_SUMS_FILE, ConfigError
from .errors import VinaFailed

logger = logging.getLogger("crista.bio-worker")

PROGRESS_STARS = 51
_RESULT_RE = re.compile(r"^REMARK VINA RESULT:\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)\s+(-?\d+\.\d+)")


@dataclass(frozen=True)
class VinaSettings:
    exhaustiveness: int = 8
    seed: int = 42
    num_modes: int = 9
    energy_range: float = 3.0


@dataclass
class VinaMode:
    rank: int
    affinity: float
    rmsd_lb: float
    rmsd_ub: float


def pinned_sha256(binary: Path) -> str | None:
    """scripts/vina-1.2.7.sha256 에서 이 파일 이름의 고정 해시를 찾는다."""
    if not VINA_SUMS_FILE.exists():
        return None
    for line in VINA_SUMS_FILE.read_text().splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == binary.name:
            return parts[0]
    return None


def check_binary(binary: Path) -> str:
    """실행 파일을 확인하고 버전 문자열('1.2.7')을 돌려준다. 문제가 있으면 ConfigError."""
    if not binary.exists():
        raise ConfigError(
            f"AutoDock Vina 실행 파일이 없습니다: {binary} — `scripts/fetch-vina.sh` 로 받으세요."
        )
    expected = pinned_sha256(binary)
    if expected is not None:
        actual = hashlib.sha256(binary.read_bytes()).hexdigest()
        if actual != expected:
            raise ConfigError(
                f"Vina 실행 파일 sha256 이 고정값과 다릅니다: {binary.name} (기대 {expected}, 실제 {actual}). "
                "scripts/fetch-vina.sh 로 다시 받으세요."
            )
    try:
        out = subprocess.run([str(binary), "--version"], capture_output=True, text=True, timeout=15, check=False)
    except OSError as exc:
        raise ConfigError(f"Vina 를 실행하지 못했습니다: {binary} — {exc}") from exc
    m = re.search(r"AutoDock Vina v?(\d+\.\d+\.\d+)", out.stdout + out.stderr)
    if not m:
        raise ConfigError(f"Vina 버전을 읽지 못했습니다: {(out.stdout + out.stderr).strip()[:200]}")
    return m.group(1)


def parse_modes(out_pdbqt: str) -> list[VinaMode]:
    modes = []
    for line in out_pdbqt.splitlines():
        m = _RESULT_RE.match(line)
        if m:
            modes.append(
                VinaMode(
                    rank=len(modes) + 1,
                    affinity=float(m.group(1)),
                    rmsd_lb=float(m.group(2)),
                    rmsd_ub=float(m.group(3)),
                )
            )
    return modes


async def run_vina(
    *,
    binary: Path,
    receptor: Path,
    ligand: Path,
    out: Path,
    center: tuple[float, float, float],
    size: tuple[float, float, float],
    settings: VinaSettings,
    cpu: int,
    on_progress: Callable[[float], None] | None = None,
    on_spawn: Callable[[asyncio.subprocess.Process], None] | None = None,
    on_exit: Callable[[asyncio.subprocess.Process], None] | None = None,
) -> str:
    """Vina 를 돌리고 결과 PDBQT 문자열을 돌려준다. 진행률(0~1)은 `*` 개수로 알린다."""
    args = [
        str(binary),
        "--receptor", str(receptor),
        "--ligand", str(ligand),
        "--out", str(out),
        "--center_x", f"{center[0]}", "--center_y", f"{center[1]}", "--center_z", f"{center[2]}",
        "--size_x", f"{size[0]}", "--size_y", f"{size[1]}", "--size_z", f"{size[2]}",
        "--exhaustiveness", str(settings.exhaustiveness),
        "--seed", str(settings.seed),
        "--num_modes", str(settings.num_modes),
        "--energy_range", f"{settings.energy_range}",
        "--cpu", str(cpu),
    ]  # fmt: skip
    proc = await asyncio.create_subprocess_exec(
        *args,
        stdin=asyncio.subprocess.DEVNULL,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT,
        start_new_session=True,
    )
    if on_spawn:
        on_spawn(proc)
    tail = bytearray()
    try:
        assert proc.stdout is not None
        in_bar = False
        stars = 0
        while True:
            chunk = await proc.stdout.read(512)
            if not chunk:
                break
            tail += chunk
            del tail[:-4096]
            if not in_bar:
                marker = tail.find(b"|----")
                if marker < 0:
                    continue
                in_bar = True
/**
 * DB — crista_web 역할 하나로 붙는 연결 풀. 모든 SQL 은 `web.` 을 붙여 쓴다(search_path 에 기대지 않는다).
 */
import pg from 'pg';
import type { Config } from './config.ts';

export type Pool = pg.Pool;
export type Tx = pg.PoolClient;
export type Queryable = Pick<pg.Pool, 'query'> | Pick<pg.PoolClient, 'query'>;

/** 서버가 요구하는 마지막 마이그레이션. */
export const REQUIRED_MIGRATION = '0001';

export function createPool(config: Pick<Config, 'databaseUrl' | 'databaseCa'>): Pool {
  const pool = new pg.Pool({
    connectionString: config.databaseUrl,
    ssl: config.databaseCa ? { ca: config.databaseCa, rejectUnauthorized: true } : false,
    max: 10,
    idleTimeoutMillis: 30_000,
    connectionTimeoutMillis: 5_000,
    application_name: 'crista-web-server',
  });
  // 쉬던 연결이 끊긴 오류 — 풀이 그 연결을 버린다. 프로세스를 죽이지 않는다.
  pool.on('error', (error) => console.error('[db] 쉬던 연결 오류:', error.message));
  return pool;
}

export async function withTx<T>(pool: Pool, fn: (tx: Tx) => Promise<T>): Promise<T> {
  const client = await pool.connect();
  try {
    await client.query('begin');
    const result = await fn(client);
    await client.query('commit');
    return result;
  } catch (error) {
    await client.query('rollback').catch(() => {});
    throw error;
  } finally {
    client.release();
  }
}

/** 시작 점검 — 전용 역할로 붙었고 필요한 마이그레이션이 적용됐는가. */
export async function assertDatabase(pool: Pool): Promise<void> {
  const who = await pool.query<{ u: string }>('select current_user as u');
  if (who.rows[0]?.u !== 'crista_web') throw new Error(`DB 역할이 crista_web 이 아닙니다(${who.rows[0]?.u}).`);
  const applied = await pool.query<{ version: string }>('select version from web.schema_migrations order by version desc limit 1');
  const latest = applied.rows[0]?.version ?? '';
  if (latest < REQUIRED_MIGRATION) throw new Error(`web 마이그레이션 ${REQUIRED_MIGRATION} 이 필요합니다(지금 ${latest || '없음'}). \`npm run db:migrate:local\``);
}

export const isUniqueViolation = (error: unknown, constraint?: string): boolean =>
  (error as { code?: string })?.code === '23505' && (constraint === undefined || (error as { constraint?: string }).constraint === constraint);

