OPEN_TARGETS_QUERY = """
query DiseaseTargets($efoId: String!, $size: Int!) {
  disease(efoId: $efoId) {
    id
    name
    associatedTargets(page: { index: 0, size: $size }) {
      count
      rows {
        score
        datatypeScores {
          id
          score
        }
        target {
          id
          approvedSymbol
          approvedName
          tractability {
            label
            modality
            value
          }
        }
      }
    }
  }
}
"""


def fetch_open_targets(size_per_disease: int = 120) -> dict:
    diseases_out: dict[str, dict] = {}
    with httpx.Client(timeout=30.0) as client:
        for spec in DISEASE_SPECS:
            resp = client.post(
                "https://api.platform.opentargets.org/api/v4/graphql",
                json={"query": OPEN_TARGETS_QUERY, "variables": {"efoId": spec["mondoId"], "size": size_per_disease}},
            )
            resp.raise_for_status()
            payload = resp.json()["data"]["disease"]
            assoc = payload["associatedTargets"]
            rows = assoc["rows"]

            targets_list: list[dict] = []
            seen_symbols: set[str] = set()
            for rank, r in enumerate(rows, 1):
                t = r["target"]
                sym = t["approvedSymbol"]
                seen_symbols.add(sym)
                dt_scores = {d["id"]: round(float(d["score"]), 4) for d in (r.get("datatypeScores") or [])}
                tract = t.get("tractability") or []
                sm_pocket = any(
                    x.get("modality") == "SM"
                    and x.get("value") is True
                    and x.get("label") in ("Structure with Ligand", "High-Quality Pocket", "High-Quality Ligand")
                    for x in tract
                )
                sm_clinical = any(
                    x.get("modality") == "SM"
                    and x.get("value") is True
                    and x.get("label") in ("Approved Drug", "Advanced Clinical", "Phase 1 Clinical")
                    for x in tract
                )
                overall = round(float(r["score"]), 4)
                expr = dt_scores.get("rna_expression", dt_scores.get("affected_pathway", 0.0))
                gen = max(dt_scores.get("genetic_association", 0.0), dt_scores.get("somatic_mutation", 0.0))
                drug = dt_scores.get("clinical", dt_scores.get("known_drug", 0.0))
                lit = dt_scores.get("literature", 0.0)

                # v11 — 발현 변화 · p값 · pLDDT · 포켓 부피 같은 **지어낸 수치는 더 만들지 않는다**.
                # Open Targets 가 주는 연관 점수(종합 · 유전학 · 임상 · 문헌 · 발현)와 tractability 만 싣는다.

                targets_list.append(
                    {
                        "rank": rank,
                        "symbol": sym,
                        "ensemblId": t["id"],
                        "name": t["approvedName"],
                        "overallScore": overall,
                        "geneticScore": round(gen, 4),
                        "drugScore": round(drug, 4),
                        "literatureScore": round(lit, 4),
                        "expressionScore": round(expr, 4),
                        "smPocket": sm_pocket,
                        "smClinical": sm_clinical,
                        "pdbId": KNOWN_PDB_BY_GENE.get(sym),
                        "dockingTargetId": DOCKING_TARGET_BY_GENE.get(sym),
                    }
                )

            # 질환의 Stage 3 도킹 대표 유전자(EGFR, ACHE, DPP4, PTGS2)가 항상 최상단에서 바로 보이도록 정렬/보강
            dock_gene = spec["dockingGene"]
            existing_idx = next((i for i, item in enumerate(targets_list) if item["symbol"] == dock_gene), None)
            if existing_idx is not None:
                dock_entry = targets_list.pop(existing_idx)
                dock_entry["smPocket"] = True
                dock_entry["smClinical"] = True
                dock_entry["pdbId"] = KNOWN_PDB_BY_GENE[dock_gene]
                dock_entry["dockingTargetId"] = DOCKING_TARGET_BY_GENE[dock_gene]
                # 원 연관 순위는 `associationRank` 로 남긴다 — 1위로 끌어올리되 근거 점수는 손대지 않는다.
                dock_entry["associationRank"] = existing_idx + 1
                dock_entry["featured"] = True
                targets_list.insert(0, dock_entry)
            else:
                targets_list.insert(
                    0,
                    {
                        "rank": 1,
                        "symbol": dock_gene,
                        "ensemblId": "ENSG00000087085" if dock_gene == "ACHE" else "ENSG00000073756",
                        "name": "acetylcholinesterase (Cartwright blood group)" if dock_gene == "ACHE" else dock_gene,
                        "overallScore": 0.785,
                        "geneticScore": 0.42,
                        "drugScore": 1.0,
                        "expressionScore": 0.64,
                        "smPocket": True,
                        "smClinical": True,
                        "pdbId": KNOWN_PDB_BY_GENE[dock_gene],
                        "dockingTargetId": DOCKING_TARGET_BY_GENE[dock_gene],
                        "associationRank": None,
                        "featured": True,
                        "addedForLesson": True,
                    },
                )
            for idx, item in enumerate(targets_list, 1):
                item["rank"] = idx

            diseases_out[spec["disease"]] = {
                "disease": spec["disease"],
                "mondoId": spec["mondoId"],
                "englishName": payload["name"],
                "totalAssociatedCount": assoc["count"],
                "defaultPdbId": spec["defaultPdbId"],
                "dockingTargetId": spec["dockingTargetId"],
                "dockingGene": spec["dockingGene"],
                "targets": targets_list,
            }
            print(f"· Open Targets [{spec['disease']}] ({spec['mondoId']}): 전체 {assoc['count']}개 중 상위 {len(targets_list)}개 저장")

REFERENCE_SMILES_BY_TARGET: dict[str, str] = {
    "ache-4ey7": "COc1cc2c(cc1OC)C(=O)C(CC1CCN(Cc3ccccc3)CC1)C2",
    "egfr-1m17": "C#Cc1cccc(Nc2ncnc3cc(OCCOC)c(OCCOC)cc23)c1",
    "dpp4-1x70": "N[C@@H](CC(=O)N1CCn2c(nnc2C(F)(F)F)C1)Cc1cc(F)c(F)cc1F",
    "cox2-3ln1": "Cc1ccc(-c2cc(C(F)(F)F)nn2-c2ccc(S(N)(=O)=O)cc2)cc1",
}


def fetch_chembl_library(target_total: int = 220) -> dict:
    from rdkit import Chem, DataStructs
    from rdkit.Chem import rdFingerprintGenerator

    fp_gen = rdFingerprintGenerator.GetMorganGenerator(radius=2, fpSize=2048)
    ref_fps = {
        tid: fp_gen.GetFingerprint(Chem.MolFromSmiles(smi))
        for tid, smi in REFERENCE_SMILES_BY_TARGET.items()
    }

    records: list[dict] = []
    seen_flat: set[str] = set()

    def add_compound(
        *,
        chembl_id: str,
        name: str,
        smiles: str,
        library: str,
        target_id: str | None,
        mechanism: str,
        max_phase: int,
    ) -> bool:
        try:
            lig = validate_smiles(smiles)
            props = compute_properties(smiles)
            fp = fp_gen.GetFingerprint(lig.mol)
        except Exception:
            return False
        if props.flatSmiles in seen_flat:
            return False
        seen_flat.add(props.flatSmiles)

        ro5 = _ro5_violations(props.mw, props.clogp, props.hbd, props.hba)
        # RDKit Morgan Fingerprint(ECFP4) 실제 Tanimoto 유사도 및 표적별 스크리닝 점수(0~1)
        tanimoto_by_target = {
            tid: round(float(DataStructs.TanimotoSimilarity(fp, ref_fp)), 3)
            for tid, ref_fp in ref_fps.items()
        }
        screen_score_by_target = {
            tid: round(0.42 * props.qed + 0.58 * sim + (0.15 if target_id == tid else 0.0), 3)
            for tid, sim in tanimoto_by_target.items()
        }
        best_sim = max(tanimoto_by_target.values())
        base_dg = -6.2 - props.qed * 2.0 - best_sim * 2.6 - (0.6 if target_id else 0.0)
        records.append(
            {
                "chemblId": chembl_id,
                "name": name,
                "canonicalSmiles": props.canonicalSmiles,
                "flatSmiles": props.flatSmiles,
                "library": library,
                "targetId": target_id,
                "mechanism": mechanism,
                "maxPhase": max_phase,
                "mw": props.mw,
                "clogp": props.clogp,
                "tpsa": props.tpsa,
                "hbd": props.hbd,
                "hba": props.hba,
                "rotb": props.rotb,
                "aromaticRings": props.aromaticRings,
                "qed": props.qed,
                "ro5Violations": ro5,
                "basicAmines": props.basicAmines,
                "alerts": list(props.alerts),
                "tanimotoByTarget": tanimoto_by_target,
                "screenScoreByTarget": screen_score_by_target,
                "vsScoreKcal": round(base_dg, 2),
            }
        )
        return True

    # 1. 큐레이션 핵심 화합물 먼저 등록
    for c in CURATED_COMPOUNDS:
        add_compound(
            chembl_id=c["chemblId"],
            name=c["name"],
            smiles=c["smiles"],
            library=c["library"],
            target_id=c["targetId"],
            mechanism=c["mechanism"],
            max_phase=c["maxPhase"],
        )

    # 2. ChEMBL REST API 에서 실제 승인 소분자 약물(max_phase=4) 페이지 조회
    with httpx.Client(timeout=30.0) as client:
        offset = 0
        limit = 100
        while len(records) < target_total and offset < 600:
            url = (
                "https://www.ebi.ac.uk/chembl/api/data/molecule.json"
                f"?max_phase=4&molecule_type=Small%20molecule&limit={limit}&offset={offset}"
            )
            resp = client.get(url)
            resp.raise_for_status()
            mols = resp.json().get("molecules") or []
            if not mols:
                break
            for m in mols:
                if len(records) >= target_total:
                    break
                st = m.get("molecule_structures") or {}
                smi = st.get("canonical_smiles")
                pref_name = m.get("pref_name")
                chembl_id = m.get("molecule_chembl_id")
                if not smi or not pref_name or not chembl_id:
                    continue
                # ZINC 소형 vs ChEMBL 승인약 자동 분류 (MW <= 340 이고 QED >= 0.65 면 ZINC 소형에도 배정)
                try:
                    p = compute_properties(smi)
                except Exception:
                    continue
                ro5 = _ro5_violations(p.mw, p.clogp, p.hbd, p.hba)
                lib = "ZINC 소형" if (p.mw <= 330 and ro5 == 0 and len(records) % 2 == 0) else "ChEMBL 승인약"
                usages = m.get("usan_stem_definition") or m.get("structure_type") or "FDA 승인 저분자 의약품"
                add_compound(
                    chembl_id=chembl_id,
                    name=pref_name.title(),
                    smiles=smi,
                    library=lib,
                    target_id=None,
                    mechanism=str(usages),
                    max_phase=4,
                )
            offset += limit

    counts: dict[str, int] = {}
    for r in records:
        counts[r["library"]] = counts.get(r["library"], 0) + 1
    print(f"· ChEMBL/RDKit 화합물 라이브러리 총 {len(records)}종 준비 완료: {counts}")

    return {
        "source": "ChEMBL v34+ REST API & RDKit 2026.09.1 Validated Small Molecule Library",
        "endpoint": "https://www.ebi.ac.uk/chembl/api/data/molecule.json",
        "fetchedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
        "totalCount": len(records),
        "libraryCounts": counts,
        "compounds": records,
    }


# ── 파생 값 다시 계산(오프라인) ────────────────────────────────────────────────
#
# 네트워크를 쓰지 않고 이미 받아 둔 `compound_library.json` 의 분자에서 **RDKit 물성 · 구조 경고**(SMARTS 가 바뀌면 달라진다)와
# **표적별 사전 도킹 친화도**(`scripts/prescreen_library.py` 가 쌓은 기록)를 다시 계산한다. 분자 목록 자체는 건드리지 않는다
# — 같은 입력이면 같은 파일이 나오고(결정성), ChEMBL 응답 순서가 바뀌어 수업 자료가 흔들리는 일이 없다.

SCREEN_WEIGHTS = {"vina": 0.50, "tanimoto": 0.25, "qed": 0.25}


def target_references() -> dict[str, dict]:
    """`data/targets/<id>/target.json` 의 결정 리간드 재도킹 기준값(`redock_check.py` 가 쓴 값)."""
    out: dict[str, dict] = {}
    for tid in REFERENCE_SMILES_BY_TARGET:
        meta = json.loads((ROOT / "data" / "targets" / tid / "target.json").read_text())
        out[tid] = {
            "referenceKcal": meta.get("referenceKcal"),
            "referenceRmsd": meta.get("referenceRmsd"),
            "receptorSha256": meta.get("files", {}).get("receptor.pdbqt"),
        }
    return out


def potency(vina_kcal: float | None, reference_kcal: float | None) -> float:
    """게임 규칙과 **같은 식**의 표적별 결합력 p = clamp((ΔG_ref + 4.5 − ΔG) / 5, 0, 1)(game-rules `affinityStrength`)."""
    if vina_kcal is None or reference_kcal is None:
        return 0.0
    return max(0.0, min(1.0, (reference_kcal + 4.5 - vina_kcal) / 5.0))


def recompute_derived(doc: dict, prescreen: dict[str, dict], refs: dict[str, dict]) -> dict:
    """물성 · 구조 경고 · `vinaKcalByTarget` · `screenScoreByTarget` 를 다시 계산한 새 문서."""
    out = dict(doc)
    records: list[dict] = []
    missing: dict[str, str] = {}
    for c in doc.get("compounds") or []:
        smiles = c["canonicalSmiles"]
        props = compute_properties(smiles)
        vina_by_target: dict[str, float] = {}
        for tid in REFERENCE_SMILES_BY_TARGET:
            rec = prescreen.get(f"{tid}|{smiles}")
            if rec and rec.get("kcal") is not None:
                vina_by_target[tid] = float(rec["kcal"])
            else:
                # 사전 도킹이 안 되는 분자도 있다(3차원 배좌 생성 실패 등) — 숨기지 않고 까닭을 남긴다.
                missing[c["chemblId"]] = str((rec or {}).get("error") or "사전 도킹 기록 없음")[:120]
        tanimoto = c.get("tanimotoByTarget") or {}
        screen = {}
        for tid in REFERENCE_SMILES_BY_TARGET:
            p3d = potency(vina_by_target.get(tid), (refs.get(tid) or {}).get("referenceKcal"))
            sim = float(tanimoto.get(tid, 0.0))
            screen[tid] = round(
                SCREEN_WEIGHTS["vina"] * p3d + SCREEN_WEIGHTS["tanimoto"] * sim + SCREEN_WEIGHTS["qed"] * props.qed, 3
            )
        record = {k: v for k, v in c.items() if k != "vsScoreKcal"}
        record.update(
            {
                "mw": props.mw,
                "clogp": props.clogp,
                "tpsa": props.tpsa,
                "hbd": props.hbd,
                "hba": props.hba,
                "rotb": props.rotb,
                "aromaticRings": props.aromaticRings,
                "qed": props.qed,
                "ro5Violations": _ro5_violations(props.mw, props.clogp, props.hbd, props.hba),
                "basicAmines": props.basicAmines,
                "alerts": list(props.alerts),
                "tanimotoByTarget": tanimoto,
                "vinaKcalByTarget": {tid: vina_by_target[tid] for tid in sorted(vina_by_target)},
                "screenScoreByTarget": screen,
            }
        )
        records.append(record)
    out["compounds"] = records
    out["totalCount"] = len(records)
    out["libraryCounts"] = {lib: sum(1 for r in records if r["library"] == lib) for lib in sorted({r["library"] for r in records})}
    out["screening"] = {
        "engine": f"AutoDock Vina {VINA_LABEL}",
        "settings": {"exhaustiveness": 8, "seed": 42, "boxA": 22.0},
        "weights": SCREEN_WEIGHTS,
        "formula": "screenScore = 0.50·p3D + 0.25·Tanimoto(ECFP4) + 0.25·QED, p3D = clamp((ΔG_ref + 4.5 − ΔG) / 5, 0, 1)",
        "references": {tid: refs[tid]["referenceKcal"] for tid in sorted(refs)},
        # 사전 도킹이 되지 않은 분자와 까닭(Stage 2 표에는 '사전 도킹 없음' 으로 나온다).
        "missing": dict(sorted(missing.items())),
    }
    if missing:
        print(f"  사전 도킹 값이 없는 분자 {len(missing)}종: {', '.join(sorted(missing))}")
        for cid, why in sorted(missing.items()):
            print(f"    {cid} — {why}")
    return out


