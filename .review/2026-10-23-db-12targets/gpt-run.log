  | 'bad_request'
  | 'unauthorized'
  | 'forbidden'
  | 'not_found'
  | 'rate_limited'
  | 'auth_unavailable'
  | 'internal'
  // 가입 · 로그인
  | 'invalid_class_code'
  | 'class_closed'
  | 'class_full'
  | 'login_id_taken'
  | 'invalid_credentials'
  | 'login_locked'
  // 입사 · 등기
  | 'already_in_team'
  | 'team_full'
  | 'not_assigned'
  | 'not_in_team'
  | 'already_registered'
  | 'not_registered'
  | 'name_taken'
  | 'ticker_taken'
  | 'name_locked';

export interface ApiErrorBody {
  error: { code: ErrorCode; message: string; retryAfterSec?: number; team?: TeamView };
}

