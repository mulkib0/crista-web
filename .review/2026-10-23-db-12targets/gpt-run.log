async function readApplied(client) {
  const exists = await client.query(`select to_regclass('web.schema_migrations') is not null as ok`);
  if (!exists.rows[0].ok) return new Map();
  const rows = await client.query('select version, name, checksum, applied_at, applied_by from web.schema_migrations order by version');
  return new Map(rows.rows.map((row) => [row.version, row]));
}

async function applyOne(client, file, extraSql = []) {
  await client.query('begin');
  try {
    await client.query('select pg_advisory_xact_lock(hashtext($1))', [LOCK_KEY]);
    const already = (await readApplied(client)).get(file.version);
    if (already) {
      await client.query('rollback');
      if (already.checksum !== file.checksum) fail(`${file.file} 가 다른 실행에서 다른 체크섬으로 적용됐습니다.`);
      log(`${file.file} — 다른 실행이 먼저 적용함, 넘어감`);
      return;
    }
    await client.query(file.sql);
    for (const sql of extraSql) await client.query(sql);
    await client.query('insert into web.schema_migrations (version, name, checksum) values ($1, $2, $3)', [file.version, file.name, file.checksum]);
    await client.query('commit');
    log(`${file.file} 적용(${describe(process.env[file.version === BOOTSTRAP ? 'CRISTA_DATABASE_URL' : 'WEB_DATABASE_URL'])})`);
  } catch (error) {
    await client.query('rollback').catch(() => {});
    throw error;
-- 0000_bootstrap — 관리자 연결(CRISTA_DATABASE_URL)로 한 번만 적용한다(설계 §7.2).
--   역할 crista_web · 스키마 web · 실행기 기록 표 · auth.users 를 가리키는 유일한 표 web.accounts.
--   crista_web 의 비밀번호는 이 파일에 없다 — 실행기(db/migrate.mjs)가 WEB_DATABASE_URL 의 비밀번호로
--   SCRAM 검증값을 만들어 같은 트랜잭션에서 `alter role … password` 로 넣는다(평문이 DB 로그에 남지 않게).
--
-- 왜 web.accounts 가 여기 있나:
--   관리자 역할 postgres 는 auth.users 에 REFERENCES 권한이 있지만 남에게 넘길 권한(grant option)은 없다
--   (로컬에서 확인 — relacl `postgres=ar*wdDxtm`). 그래서 auth.users 로 거는 외래 키는 관리자가 만든 표만 가질 수 있다.
--   나머지 표(0001~)는 crista_web 이 만들고 소유하며 web.accounts 를 가리킨다.
--
-- 이 파일은 public 등 다른 스키마의 객체를 만들거나 바꾸지 않는다. 걷어내기: db/README.md.

do $$
begin
  if not exists (select 1 from pg_roles where rolname = 'crista_web') then
    create role crista_web login nosuperuser nocreatedb nocreaterole noreplication nobypassrls noinherit connection limit 30;
  end if;
end
