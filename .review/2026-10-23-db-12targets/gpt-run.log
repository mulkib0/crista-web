#!/usr/bin/env python
"""
Stage 1 · Stage 2 실제 생물·화학 데이터셋 준비 스크립트.

1. Open Targets Platform GraphQL v4 (`https://api.platform.opentargets.org/api/v4/graphql`)
   - 4대 질환(비소세포폐암 `MONDO_0005233`, 알츠하이머 `MONDO_0004975`, 2형 당뇨 `MONDO_0005148`, 류마티스 관절염 `MONDO_0008383`)별
     실제 연관 유전자 상위 120개씩(총 480개)을 조회하여 `data/datasets/disease_targets.json` 에 저장한다.
2. ChEMBL REST API (`https://www.ebi.ac.uk/chembl/api/data/molecule.json`) + 표적별 활성 화합물 · 유도체
   - 실제 승인 약물(`max_phase=4`) · 소형 리드 화합물 · 의약화학 유도체를 수집하고
     RDKit(`app.properties.compute_properties`)로 전수 물성(MW, cLogP, TPSA, HBD, HBA, RotB, QED, RO5, 염기성 아민, 구조 경고)을
     계산해 `data/datasets/compound_library.json` 에 저장한다.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import sys
from datetime import datetime, timezone
from pathlib import Path

import httpx

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from app.docking.validate import validate_smiles  # noqa: E402
from app.properties import compute_properties  # noqa: E402

DATASETS_DIR = ROOT / "data" / "datasets"

