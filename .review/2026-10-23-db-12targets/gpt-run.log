PREPARE_VERSION = "prepare_target/1"


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def fetch_cif(pdb_id: str) -> Path:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    path = CACHE_DIR / f"{pdb_id}.cif"
    if path.exists() and path.stat().st_size > 0:
        return path
    url = f"https://files.rcsb.org/download/{pdb_id}.cif"
    print(f"· RCSB 에서 받는 중: {url}")
    with urllib.request.urlopen(url, timeout=60) as resp:  # noqa: S310 — 고정 https 주소
        data = resp.read()
    tmp = path.with_suffix(".cif.part")
    tmp.write_bytes(data)
    tmp.replace(path)
    return path


def tool_versions() -> dict[str, str]:
    import gemmi
    import rdkit
    from openbabel import openbabel as ob

    return {
        "gemmi": gemmi.__version__,
        "openbabel": ob.OBReleaseVersion(),
        "rdkit": rdkit.__version__,
        "script": PREPARE_VERSION,
    }


def build(target_id: str) -> dict[str, bytes]:
    """표적 파일들을 메모리에서 만든다. {파일 이름: 내용}."""
    import gemmi
    from openbabel import openbabel as ob
    from rdkit import Chem
    from rdkit.Chem import AllChem

    spec = TARGETS[target_id]
    cif = fetch_cif(spec["pdbId"])
    chain = spec["chain"]
    ref = spec["referenceLigand"]

    st = gemmi.read_structure(str(cif))
    st.setup_entities()
    while len(st) > 1:
        del st[1]
    st.remove_alternative_conformations()
    st.remove_hydrogens()
    for name in [ch.name for ch in st[0]]:
        if name != chain:
            st[0].remove_chain(name)

    # ── 결정 리간드(지정 사슬의 첫 번째 같은 이름 잔기) ──
    lig_lines: list[str] = []
    serial = 0
    found = None
    for res in st[0][chain]:
        if res.name == ref["resname"]:
            found = res
            break
    if found is None:
        raise SystemExit(f"{spec['pdbId']} {chain} 사슬에 {ref['resname']} 이 없습니다")
    for atom in found:
        serial += 1
        p = atom.pos
        name = atom.name if len(atom.name) >= 4 else f" {atom.name:<3}"
        lig_lines.append(
            f"HETATM{serial:5d} {name:<4} {found.name:>3} {chain}{found.seqid.num:4d}    "
            f"{p.x:8.3f}{p.y:8.3f}{p.z:8.3f}  1.00 {atom.b_iso:5.2f}          {atom.element.name.upper():>2}"
        )
    lig_block = "\n".join(lig_lines) + "\nEND\n"
    crystal = Chem.MolFromPDBBlock(lig_block, removeHs=True, sanitize=False, proximityBonding=True)
    if crystal is None:
        raise SystemExit("결정 리간드를 RDKit 으로 읽지 못했습니다")
    template = Chem.MolFromSmiles(ref["smiles"])
    ligand = AllChem.AssignBondOrdersFromTemplate(template, crystal)
    Chem.SanitizeMol(ligand)
    Chem.AssignStereochemistryFrom3D(ligand)
    if Chem.MolToSmiles(Chem.RemoveHs(ligand), isomericSmiles=False) != Chem.MolToSmiles(template, isomericSmiles=False):
        raise SystemExit("결정 리간드와 템플릿 SMILES 의 결합 구조가 다릅니다")
    ligand.SetProp("_Name", f"{spec['pdbId']}_{chain}_{ref['resname']}_{found.seqid.num}")
    ligand.SetProp("crista_reference", ref["name"])
    sdf = io.StringIO()
    writer = Chem.SDWriter(sdf)
    writer.SetKekulize(True)
    writer.write(ligand)
    writer.close()
    # RDKit 은 SDF 2번째 줄에 시각을 넣는다 — 재현성을 위해 비운다.
    sdf_lines = sdf.getvalue().split("\n")
    sdf_lines[1] = "     RDKit          3D"
    sdf_text = "\n".join(sdf_lines)

    conf = ligand.GetConformer()
    n = ligand.GetNumAtoms()
    center = [
        round(sum(conf.GetAtomPosition(i).x for i in range(n)) / n, 3),
        round(sum(conf.GetAtomPosition(i).y for i in range(n)) / n, 3),
        round(sum(conf.GetAtomPosition(i).z for i in range(n)) / n, 3),
    ]

    # ── 단백질: 물·리간드 제거 ──
    st.remove_ligands_and_waters()
    st.remove_empty_chains()
    opts = gemmi.PdbWriteOptions(minimal=True)
    opts.conect_records = False
    protein_pdb = st.make_pdb_string(opts)

    # ── Open Babel: pH 7.4 수소 추가 ──
    conv = ob.OBConversion()
    conv.SetInFormat("pdb")
    mol = ob.OBMol()
    if not conv.ReadString(mol, protein_pdb):
        raise SystemExit("Open Babel 이 단백질 PDB 를 읽지 못했습니다")
    mol.AddHydrogens(False, True, spec["pH"])

    def keep(text: str, tags: tuple[str, ...]) -> str:
        lines = [ln for ln in text.splitlines() if ln.startswith(tags)]
        return "\n".join(lines) + "\n"

    conv_pdb = ob.OBConversion()
    conv_pdb.SetOutFormat("pdb")
    receptor_h = keep(conv_pdb.WriteString(mol), ("ATOM", "HETATM", "TER")) + "END\n"

    conv_qt = ob.OBConversion()
    conv_qt.SetOutFormat("pdbqt")
    conv_qt.AddOption("r", ob.OBConversion.OUTOPTIONS)
    receptor_qt = keep(conv_qt.WriteString(mol), ("ATOM", "HETATM", "TER"))

    return {
        "receptor.pdbqt": receptor_qt.encode(),
        "receptor_h.pdb": receptor_h.encode(),
        "reference_ligand.sdf": sdf_text.encode(),
        "_meta": json.dumps(
            {
                "center": center,
                "ligandSeq": found.seqid.num,
                "ligandHeavyAtoms": n,
                "sourceSha256": sha256_file(cif),
                "receptorAtoms": receptor_qt.count("\nATOM") + receptor_qt.startswith("ATOM"),
            }
        ).encode(),
    }


def target_json(target_id: str, files: dict[str, bytes], previous: dict | None) -> dict:
    spec = TARGETS[target_id]
    meta = json.loads(files["_meta"])
    hashes = {name: sha256_bytes(data) for name, data in files.items() if not name.startswith("_")}
    size = spec["boxSize"]
    doc = {
        "id": target_id,
        "pdbId": spec["pdbId"],
        "chain": spec["chain"],
        "label": spec["label"],
        "gene": spec["gene"],
        "source": {
            "url": f"https://files.rcsb.org/download/{spec['pdbId']}.cif",
            "sha256": meta["sourceSha256"],
            "license": "CC0 1.0 (RCSB PDB)",
        },
        "referenceLigand": {
            **spec["referenceLigand"],
            "chain": spec["chain"],
            "seq": meta["ligandSeq"],
            "heavyAtoms": meta["ligandHeavyAtoms"],
        },
        "box": {"center": meta["center"], "size": [size, size, size], "basis": "결정 리간드 중원자 중심"},
        "protonation": {"tool": "openbabel AddHydrogens(False, True, pH)", "pH": spec["pH"]},
        "files": hashes,
        "tools": tool_versions(),
        "preparedAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
    }
    if previous and previous.get("files") == hashes and previous.get("box") == doc["box"]:
        doc["preparedAt"] = previous.get("preparedAt", doc["preparedAt"])
        # 재도킹 기준값(scripts/redock_check.py 가 쓴다)은 같은 수용체면 그대로 가져온다 — 다시 준비해도 날아가지 않는다.
        for key in ("referenceKcal", "referenceRmsd", "redock"):
            if key in previous:
                doc[key] = previous[key]
    return doc


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    parser.add_argument("target", nargs="?", default="ache-4ey7", choices=sorted(TARGETS))
    parser.add_argument("--check", action="store_true", help="쓰지 않고 커밋된 파일과 같은지만 확인")
    args = parser.parse_args(argv)

    out_dir = TARGETS_DIR / args.target
    files = build(args.target)
    previous = None
    if (out_dir / "target.json").exists():
        previous = json.loads((out_dir / "target.json").read_text())
    doc = target_json(args.target, files, previous)

    if args.check:
        same = previous is not None and previous.get("files") == doc["files"] and previous.get("box") == doc["box"]
        for name, digest in doc["files"].items():
            path = out_dir / name
            ok = path.exists() and sha256_file(path) == digest
            print(f"  {'같음' if ok else '다름'}  {name}  {digest[:16]}…")
            same = same and ok
        print("결과:", "커밋된 표적 파일과 같습니다" if same else "다릅니다 — 다시 준비해야 합니다")
        return 0 if same else 1

    out_dir.mkdir(parents=True, exist_ok=True)
    for name, data in files.items():
        if name.startswith("_"):
            continue
        (out_dir / name).write_bytes(data)
    (out_dir / "target.json").write_text(json.dumps(doc, ensure_ascii=False, indent=2) + "\n")
    print(f"· {out_dir.relative_to(ROOT)} 에 썼습니다")
    print(f"  상자 중심 {doc['box']['center']} · 크기 {doc['box']['size'][0]}Å · 리간드 중원자 {doc['referenceLigand']['heavyAtoms']}")
    for name, digest in doc["files"].items():
        print(f"  {name}  sha256 {digest}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

