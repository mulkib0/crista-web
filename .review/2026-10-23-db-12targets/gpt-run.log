"""
Stage 1 (Open Targets 질환-유전자 연관 DB) · Stage 2 (ChEMBL/RDKit 화합물 라이브러리) 로더 및 조회기.

`data/datasets/disease_targets.json` 과 `data/datasets/compound_library.json` 을 프로세스 메모리에 한 번 올려 두고
Stage 1 표적 스크리닝, Stage 2 HTVS 필터링, 그리고 `GET /datasets/*` REST 엔드포인트에서 즉시 응답한다.
`manifest.json`(`scripts/prepare_datasets.py` 가 쓴다)은 파일 해시 · 레코드 수의 근거라 기동 때 한 번 대조한다.

v11 — 깔때기는 **학생이 정한 조건 그대로** 센다. 조건이 좁아 0종이 남아도 몰래 되돌리지 않는다(그것도 연구 결과다).
대신 어느 단계에서 몇 종이 떨어졌는지(`funnel`)와 완화 제안(`suggestions`)을 함께 돌려준다.
"""

from __future__ import annotations

import functools
import hashlib
import json
from pathlib import Path
from typing import Any

DATASETS_DIR = Path(__file__).resolve().parents[1] / "data" / "datasets"

#: 질환 이름의 별칭 — 화면 · 폼이 쓰는 짧은 이름을 데이터셋 키로 옮긴다(부분 일치 추측은 하지 않는다).
DISEASE_ALIASES: dict[str, str] = {
    "알츠하이머병": "알츠하이머",
    "2형 당뇨병": "2형 당뇨",
    "제2형 당뇨병": "2형 당뇨",
    "비소세포폐암(NSCLC)": "비소세포폐암",
}

#: Stage 2 기본 컷오프(학생이 바꿀 수 있다). 약물성의 통념 범위다 — Lipinski Ro5 위반 1개까지 · MW 520 · TPSA 140.
DEFAULT_MAX_MW = 520.0
DEFAULT_MAX_TPSA = 140.0


class DatasetError(ValueError):
    """조회 입력이 잘못됐다 — REST 는 400, 작업 경로는 고정 결과로 떨어진다."""


@functools.lru_cache(maxsize=1)
def load_disease_targets() -> dict[str, Any]:
    path = DATASETS_DIR / "disease_targets.json"
    if not path.exists():
        return {"diseases": {}}
    return json.loads(path.read_text(encoding="utf-8"))


@functools.lru_cache(maxsize=1)
def load_compound_library() -> dict[str, Any]:
    path = DATASETS_DIR / "compound_library.json"
    if not path.exists():
        return {"compounds": [], "totalCount": 0, "libraryCounts": {}}
    return json.loads(path.read_text(encoding="utf-8"))


@functools.lru_cache(maxsize=1)
def load_manifest() -> dict[str, Any] | None:
    path = DATASETS_DIR / "manifest.json"
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def library_names() -> list[str]:
    """데이터셋에 실제로 있는 라이브러리 이름 — 오타가 조회 범위를 몰래 넓히지 않게 이 목록으로 검증한다."""
    doc = load_compound_library()
    counts = doc.get("libraryCounts") or {}
    if counts:
        return sorted(counts)
    return sorted({str(c.get("library")) for c in (doc.get("compounds") or []) if c.get("library")})


def verify_datasets() -> list[str]:
    """
    매니페스트와 실제 파일을 대조한다(기동 때 한 번). 어긋난 점을 사람이 읽는 문장으로 돌려준다 — 빈 목록이면 정상.
    데이터 파일이 통째로 없으면 고정 결과로 돌아가는 구성이라 경고하지 않는다(매니페스트도 없다).
    """
    manifest = load_manifest()
    if manifest is None:
        return [] if not (DATASETS_DIR / "compound_library.json").exists() else ["manifest.json 이 없습니다 — scripts/prepare_datasets.py 로 다시 만드세요."]
    problems: list[str] = []
    for name, info in (manifest.get("files") or {}).items():
        path = DATASETS_DIR / name
        if not path.exists():
            problems.append(f"{name} 이 없습니다(매니페스트에는 있습니다).")
            continue
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
        if actual != info.get("sha256"):
            problems.append(f"{name} 의 sha256 이 매니페스트와 다릅니다(기대 {str(info.get('sha256'))[:16]}… · 실제 {actual[:16]}…).")
    counts = {
        "disease_targets.json": sum(len(r.get("targets") or []) for r in (load_disease_targets().get("diseases") or {}).values()),
        "compound_library.json": len(load_compound_library().get("compounds") or []),
    }
    for name, got in counts.items():
        want = ((manifest.get("files") or {}).get(name) or {}).get("records")
        if want is not None and want != got:
            problems.append(f"{name} 의 레코드 수가 다릅니다(매니페스트 {want} · 실제 {got}).")
    return problems


def get_disease_record(disease_query: str | None) -> dict[str, Any] | None:
    """질환 이름 · MONDO id → 레코드. 별칭만 허용하고 부분 일치 추측은 하지 않는다('암' 이 비소세포폐암이 되지 않게)."""
    doc = load_disease_targets()
    diseases: dict[str, Any] = doc.get("diseases") or {}
    if not diseases or not disease_query:
        return None
    q = str(disease_query).strip()
    if q in diseases:
        return diseases[q]
    alias = DISEASE_ALIASES.get(q)
    if alias and alias in diseases:
        return diseases[alias]
    for record in diseases.values():
        if q == record.get("mondoId") or q == record.get("englishName"):
            return record
    return None


def filter_compounds(
    *,
    library: str | None = None,
    target_id: str | None = None,
    max_mw: float | None = None,
    max_tpsa: float | None = None,
    ro5_only: bool = False,
    exclude_alerts: bool = False,
    limit: int = 50,
) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    """
    화합물 라이브러리를 학생이 정한 깔때기로 좁힌다 — 라이브러리 → 물성(MW · TPSA) → Ro5 → 구조 경고 → 표적 순위.

    반환: (선별된 후보, 깔때기 통계). 통계의 `funnel` 은 **각 단계를 통과한 수**이고, 조건이 좁아 0종이 되면 0 을 그대로 돌려준다.
    `suggestions` 는 어느 조건을 얼마나 풀면 몇 종이 남는지 — 학생이 직접 고르게 한다(서버가 몰래 완화하지 않는다).
    """
    doc = load_compound_library()
    all_compounds: list[dict[str, Any]] = list(doc.get("compounds") or [])
    total = len(all_compounds)
    if not all_compounds:
        return [], {"total": 0, "funnel": {"library": 0, "mwTpsa": 0, "ro5": 0, "alerts": 0, "selected": 0}, "cutoffs": {}, "suggestions": []}

    known = library_names()
    lib_q = str(library).strip() if library else ""
    if lib_q and lib_q not in known:
        raise DatasetError(f"모르는 화합물 라이브러리입니다: {lib_q!r} — {' · '.join(known)} 중에서 고르세요.")
    pool = [c for c in all_compounds if c.get("library") == lib_q] if lib_q else list(all_compounds)

    mw_cap = float(max_mw) if (max_mw is not None and max_mw > 0) else DEFAULT_MAX_MW
    tpsa_cap = float(max_tpsa) if (max_tpsa is not None and max_tpsa > 0) else DEFAULT_MAX_TPSA
    ro5_max = 0 if ro5_only else 1

    gate_mw = [c for c in pool if float(c.get("mw", 1e9)) <= mw_cap and float(c.get("tpsa", 1e9)) <= tpsa_cap]
    gate_ro5 = [c for c in gate_mw if int(c.get("ro5Violations", 9)) <= ro5_max]
    gate_alerts = [c for c in gate_ro5 if not (exclude_alerts and (c.get("alerts") or []))]

    t_id = str(target_id).strip() if target_id else ""
    if t_id:
        gate_alerts.sort(
            key=lambda c: (
                -float((c.get("screenScoreByTarget") or {}).get(t_id, 0.0)),
                float((c.get("vinaKcalByTarget") or {}).get(t_id, 0.0)),
                str(c.get("chemblId", "")),
            )
        )
    else:
        gate_alerts.sort(key=lambda c: (-max([*(c.get("screenScoreByTarget") or {}).values(), 0.0]), str(c.get("chemblId", ""))))

    safe_limit = max(1, min(int(limit or 50), 500))
    selected = gate_alerts[:safe_limit]

    suggestions: list[str] = []
    if not selected:
        if pool and not gate_mw:
            suggestions.append(f"MW ≤ {mw_cap:g} · TPSA ≤ {tpsa_cap:g} 에서 모두 떨어졌다 — 상한을 올려 보라(이 풀의 최소 MW {min(float(c['mw']) for c in pool):.1f}).")
        elif gate_mw and not gate_ro5:
            suggestions.append("Ro5 위반 0건만 남겼더니 후보가 없다 — 위반 1건까지 받아 보라.")
        elif gate_ro5 and not gate_alerts:
            suggestions.append("구조 경고가 있는 분자를 모두 뺐더니 후보가 없다 — 경고를 허용하고 뒤에서 유도체로 고칠 수도 있다.")
        elif not pool:
            suggestions.append("고른 라이브러리에 분자가 없다 — 다른 라이브러리를 보라.")
    stats = {
        "total": total,
        "funnel": {
            "library": len(pool),
            "mwTpsa": len(gate_mw),
            "ro5": len(gate_ro5),
            "alerts": len(gate_alerts),
            "selected": len(selected),
        },
        "cutoffs": {"maxMw": mw_cap, "maxTpsa": tpsa_cap, "ro5Only": bool(ro5_only), "excludeAlerts": bool(exclude_alerts)},
        "suggestions": suggestions,
        # 옛 이름(M6 까지의 호출부 호환) — 같은 수를 가리킨다.
        "libraryTotal": len(pool),
        "gate1": len(gate_mw),
        "gate2": len(gate_alerts),
    }
    return selected, stats
"""
도킹 표적 — `data/targets/<id>/` 의 준비된 파일(`scripts/prepare_target.py` 가 만든다)을 읽는다.

기동할 때 `target.json` 의 sha256 과 실제 파일을 대조한다. 다르면 다른 수용체로 계산한 결과가
같은 캐시 키로 섞이므로 compute 모드 기동을 막는다.
"""

from __future__ import annotations

import hashlib
import json
from dataclasses import dataclass
from pathlib import Path

from ..config import ConfigError

REQUIRED_FILES = ("receptor.pdbqt", "receptor_h.pdb", "reference_ligand.sdf")


@dataclass(frozen=True)
class DockingTarget:
    id: str
    pdb_id: str
    chain: str
    label: str
    directory: Path
    center: tuple[float, float, float]
    size: tuple[float, float, float]
    receptor_sha256: str
    reference_name: str
    reference_smiles: str
    reference_flat_smiles: str

    @property
    def receptor_pdbqt(self) -> Path:
        return self.directory / "receptor.pdbqt"

    @property
    def receptor_h_pdb(self) -> Path:
        return self.directory / "receptor_h.pdb"

    @property
    def reference_sdf(self) -> Path:
        return self.directory / "reference_ligand.sdf"


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_target(directory: Path) -> DockingTarget:
    from .validate import flat_canonical

    meta_path = directory / "target.json"
    if not meta_path.exists():
        raise ConfigError(
            f"표적 파일이 없습니다: {meta_path} — `.venv/bin/python scripts/prepare_target.py` 로 먼저 준비하세요."
        )
    meta = json.loads(meta_path.read_text())
    for name in REQUIRED_FILES:
        path = directory / name
        if not path.exists():
            raise ConfigError(f"표적 파일이 없습니다: {path} — scripts/prepare_target.py 로 다시 준비하세요.")
        expected = meta["files"].get(name)
        actual = _sha256(path)
        if expected != actual:
            raise ConfigError(
                f"표적 파일 해시가 target.json 과 다릅니다: {path.name} (기대 {expected}, 실제 {actual}). "
                "scripts/prepare_target.py 로 다시 준비하세요."
            )
    ref = meta["referenceLigand"]
    flat = flat_canonical(ref["smiles"])
    if flat is None:
        raise ConfigError(f"{meta_path} 의 결정 리간드 SMILES 를 읽지 못했습니다")
    return DockingTarget(
        id=meta["id"],
        pdb_id=meta["pdbId"],
        chain=meta["chain"],
        label=meta["label"],
        directory=directory,
        center=tuple(float(v) for v in meta["box"]["center"]),  # type: ignore[arg-type]
        size=tuple(float(v) for v in meta["box"]["size"]),  # type: ignore[arg-type]
        receptor_sha256=meta["files"]["receptor.pdbqt"],
        reference_name=ref["name"],
        reference_smiles=ref["smiles"],
        reference_flat_smiles=flat,
    )


def load_targets(targets_dir: Path) -> dict[str, DockingTarget]:
    if not targets_dir.is_dir():
        raise ConfigError(f"표적 폴더가 없습니다: {targets_dir} — scripts/prepare_target.py 로 먼저 준비하세요.")
    targets = {}
    for child in sorted(targets_dir.iterdir()):
        if child.is_dir():
            target = load_target(child)
            targets[target.id] = target
    if not targets:
        raise ConfigError(f"준비된 표적이 없습니다: {targets_dir}")
    return targets
"""
Stage 3 도킹 파이프라인 — RDKit(ETKDGv3 + MMFF94) → Meeko → AutoDock Vina → PLIP.

`DockingService` 는 compute 모드 기동 때 한 번 만든다(실행 파일·표적·도구 버전 확인).
CPU 를 쓰는 파이썬 단계(리간드 준비·포즈 해석·PLIP)는 `asyncio.to_thread` 로, Vina 는 서브프로세스로 돌려
이벤트 루프를 막지 않는다.
"""

from __future__ import annotations

import asyncio
import logging
import tempfile
import time
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path

from ..config import ConfigError, Settings
from .analysis import pose_sdf, poses_from_pdbqt, plip_interactions, redock_rmsd, single_pose
from .cache import ResultCache, cache_key, make_cache
from .ligand import EMBED_SEED, prepare_ligand
from .outcome import DockingOutcome
from .targets import DockingTarget, load_targets
from .errors import InvalidDockingInput, VinaFailed
from .validate import ValidatedLigand, validate_smiles
from .vina import VinaSettings, check_binary, parse_modes, run_vina

logger = logging.getLogger("crista.bio-worker")

DEFAULT_TARGET_ID = "ache-4ey7"  # protocol.ts DEFAULT_DOCKING_TARGET_ID
# 결과·캐시 형식이 바뀌면 올린다 — 캐시 키에 들어간다.
PIPELINE_VERSION = "crista-dock/2"  # 2: provenance.settings.unassignedStereocenters
# 처음 예상 소요(ms) — 실제 계산이 끝날 때마다 이동 평균으로 고친다.
INITIAL_ESTIMATE_MS = 20_000


@dataclass
class DockingRequest:
    target: DockingTarget
    ligand: ValidatedLigand
    label: str | None
    cache_key: str


def tool_versions() -> dict[str, str]:
    import importlib.metadata as md

    import rdkit
    from openbabel import openbabel as ob

    return {
        "rdkit": rdkit.__version__,
        "meeko": md.version("meeko"),
        "plip": md.version("plip"),
        "openbabel": ob.OBReleaseVersion(),
    }


class DockingService:
    def __init__(self, settings: Settings, cache: ResultCache | None = None) -> None:
        self.settings = settings
        self.vina_settings = VinaSettings()
        self.vina_version = check_binary(settings.vina_path)
        try:
            self.tools = tool_versions()
        except Exception as exc:  # noqa: BLE001
            raise ConfigError(f"계산 도구(RDKit·Meeko·PLIP·Open Babel)를 불러오지 못했습니다: {exc}") from exc
        self.targets = load_targets(settings.targets_dir)
        self.cache = cache if cache is not None else make_cache(settings.database_url)
        self._receptor_h: dict[str, str] = {
            tid: t.receptor_h_pdb.read_text() for tid, t in self.targets.items()
        }
        self.estimate_ms = INITIAL_ESTIMATE_MS

    # ── 정보 ──
    @property
    def engines(self) -> dict[str, str]:
        return {"vina": self.vina_version, **self.tools}

    def pipeline_labels(self, force_field: str = "MMFF94") -> list[str]:
        return [
            f"RDKit {self.tools['rdkit']} ETKDGv3 + {force_field}",
            f"Meeko {self.tools['meeko']}",
            f"AutoDock Vina {self.vina_version}",
            f"PLIP {self.tools['plip']}",
        ]

    # ── 동기 검증(POST /jobs 안) ──
    def validate(self, params: dict, *, class_id: str, team_id: str) -> DockingRequest:
        target_id = params.get("targetId", DEFAULT_TARGET_ID)
        if not isinstance(target_id, str) or not target_id.strip():
            target_id = DEFAULT_TARGET_ID
        target = self.targets.get(target_id.strip())
        if target is None:
            known = ", ".join(sorted(self.targets))
            raise InvalidDockingInput(f"모르는 표적입니다: {target_id!r}. 계산할 수 있는 표적: {known}")
        if "smiles" not in params:
            raise InvalidDockingInput("도킹할 분자의 SMILES 가 없습니다. 분자 구조를 입력하세요.")
        ligand = validate_smiles(params.get("smiles"))
        label = params.get("label")
        key = cache_key(
            class_id=class_id,
            team_id=team_id,
            engine="vina",
            engine_version=self.vina_version,
            target_id=target.id,
            receptor_sha256=target.receptor_sha256,
            center=target.center,
            size=target.size,
            exhaustiveness=self.vina_settings.exhaustiveness,
            seed=self.vina_settings.seed,
            num_modes=self.vina_settings.num_modes,
            canonical_smiles=ligand.canonical_smiles,
            tool_versions={**self.tools, "pipeline": PIPELINE_VERSION},
        )
        return DockingRequest(
            target=target,
            ligand=ligand,
            label=label.strip() if isinstance(label, str) and label.strip() else None,
            cache_key=key,
        )

    def settings_record(self, target: DockingTarget) -> dict[str, str | int | float]:
        v = self.vina_settings
        return {
            "exhaustiveness": v.exhaustiveness,
            "seed": v.seed,
            "numModes": v.num_modes,
            "energyRange": v.energy_range,
            "cpu": self.settings.dock_cpu,
            "centerX": target.center[0],
            "centerY": target.center[1],
            "centerZ": target.center[2],
            "sizeX": target.size[0],
            "sizeY": target.size[1],
            "sizeZ": target.size[2],
            "embedSeed": EMBED_SEED,
            "receptorSha256": target.receptor_sha256,
            "receptorProtonation": "Open Babel pH 7.4",
            "ligandProtonation": "입력 SMILES 그대로",
        }

    # ── 계산 ──
    async def compute(
        self,
        req: DockingRequest,
        *,
        on_phase: Callable[[str, float], None],
        on_spawn: Callable[[asyncio.subprocess.Process], None] | None = None,
        on_exit: Callable[[asyncio.subprocess.Process], None] | None = None,
    ) -> DockingOutcome:
        """prepare(0~0.1) → dock(0.1~0.9) → analyze(0.9~1.0). 실패는 예외로 알린다."""
        t0 = time.monotonic()
        target = req.target
        on_phase("prepare", 0.0)
        prepared = await asyncio.to_thread(prepare_ligand, req.ligand.mol)
        on_phase("prepare", 0.1)

        with tempfile.TemporaryDirectory(prefix="crista-dock-") as tmp:
            lig_path = Path(tmp) / "ligand.pdbqt"
            out_path = Path(tmp) / "out.pdbqt"
            lig_path.write_text(prepared.pdbqt)
            on_phase("dock", 0.1)
            out_text = await run_vina(
                binary=self.settings.vina_path,
                receptor=target.receptor_pdbqt,
                ligand=lig_path,
                out=out_path,
                center=target.center,
                size=target.size,
                settings=self.vina_settings,
                cpu=self.settings.dock_cpu,
                on_progress=lambda frac: on_phase("dock", 0.1 + 0.8 * frac),
                on_spawn=on_spawn,
                on_exit=on_exit,
            )
        modes = parse_modes(out_text)
        if not modes:
            raise VinaFailed("AutoDock Vina 가 포즈를 하나도 내지 못했습니다")

        on_phase("analyze", 0.9)
        is_reference = req.ligand.flat_smiles == target.reference_flat_smiles
        outcome = await asyncio.to_thread(self._analyze, req, out_text, modes, is_reference, prepared.force_field)
        outcome.compute_ms = int((time.monotonic() - t0) * 1000)
        outcome.computed_at = int(time.time() * 1000)
        on_phase("analyze", 1.0)
        # 예상 소요를 이동 평균으로 고친다(클라이언트 진행률 추정용).
        self.estimate_ms = int(0.7 * self.estimate_ms + 0.3 * outcome.compute_ms)
        return outcome

    def _analyze(self, req, out_text, modes, is_reference: bool, force_field: str) -> DockingOutcome:
        target = req.target
        poses = poses_from_pdbqt(out_text)
        top = single_pose(poses, 0)
        rmsd = redock_rmsd(top, target.reference_sdf) if is_reference else None
        interactions = plip_interactions(self._receptor_h[target.id], top)
        sdf = pose_sdf(top, name=f"{target.pdb_id} pose 1", affinity=modes[0].affinity)
        return DockingOutcome(
            target_id=target.id,
            pdb_id=target.pdb_id,
            canonical_smiles=req.ligand.canonical_smiles,
            heavy_atoms=req.ligand.heavy_atoms,
            modes=modes,
            interactions=interactions,
            pose_sdf=sdf,
            computed_at=0,
            compute_ms=0,
            engine_version=self.vina_version,
            pipeline=self.pipeline_labels(force_field),
            settings={
                **self.settings_record(target),
                "unassignedStereocenters": req.ligand.unassigned_stereocenters,
            },
            redock_rmsd=None if rmsd is None else round(rmsd, 3),
            removed_fragments=list(req.ligand.removed_fragments),
        )
"""
계산 캐시 — 같은 팀이 같은 설정으로 같은 분자를 다시 요청하면 Vina 를 다시 돌리지 않는다.

키 = sha256(class_id · team_id · 엔진·버전 · target_id · 수용체 sha256 · 상자 · exhaustiveness · seed ·
num_modes · 정규 SMILES(입체 포함) · 파이프라인 도구 버전). **class_id·team_id 가 키에 들어가므로
팀 사이에는 재사용하지 않는다** — 재사용하면 '다른 팀이 이 분자를 계산했다'는 사실이 샌다(브리프 §4.3).

저장소:
- `CRISTA_WORKER_DATABASE_URL` 이 있으면 PostgreSQL `simulation_cache`(psycopg). 팀·작업 식별자를 뺀
  과학 결과(`DockingOutcome`)를 `result` 에, 포즈 SDF·정규 SMILES 를 `artifacts` 에 둔다.
  적중하면 `hit_count`·`last_hit_at` 을 갱신한다.
  연결은 `psycopg_pool.AsyncConnectionPool` 하나로 나눠 쓴다(M3 브리프 §4.9 — 조회·저장마다 새 연결을 맺지 않는다).
  풀은 처음 쓸 때 열고, 앱 종료(lifespan) 때 `close()` 로 닫는다.
- 없으면 프로세스 메모리(풀을 만들지 않는다).
DB 에 닿지 않으면 경고 로그만 남기고 캐시 없이 계산한다 — 작업을 실패시키지 않는다.
"""

from __future__ import annotations

import asyncio
import hashlib
import json
import logging
from typing import TYPE_CHECKING, Protocol

from .outcome import DockingOutcome

if TYPE_CHECKING:
    from psycopg_pool import AsyncConnectionPool

logger = logging.getLogger("crista.bio-worker")

CONNECT_TIMEOUT_S = 3

# 풀 크기. 캐시 질의는 도킹 작업마다 조회 1번(대기열에 들어가기 전)과 저장 1번(Vina 가 끝난 뒤)이고 각각 수 ms 다.
# 저장은 동시 도킹 상한(`CRISTA_DOCK_MAX_CONCURRENT`, 기본 2)을 넘지 않으므로, 저장 2 + 그 사이 새 작업의 조회를
# 겹쳐도 최대 4 개면 기다림이 거의 없다. 더 몰리면 풀 안에서 잠깐 줄을 선다(아래 대기 상한 안에서).
# 최소는 0 — 연결은 첫 질의가 올 때 맺고(지연 열기), 한 번 맺은 연결은 돌려받아 다음 질의에 다시 쓴다.
# 최소를 1 로 두면 풀을 여는 순간 배경에서 1 개를 맺는 사이 첫 질의가 줄을 서며 풀이 하나 더 늘어 처음부터 2 개가 된다.
# 10분(`max_idle`) 넘게 쓰지 않은 연결은 풀이 닫고, 다음 질의 때 다시 맺는다.
POOL_MIN_SIZE = 0
POOL_MAX_SIZE = 4
# 풀에서 연결을 얻을 때 기다리는 상한. DB 에 닿지 않으면 풀은 뒤에서 재접속을 되풀이하고, 요청은 이만큼만 기다린 뒤
# 예전처럼 '캐시 없음' 으로 계산을 이어 간다. 예전의 연결 제한 시간(`connect_timeout`)과 같은 값이다.
POOL_TIMEOUT_S = float(CONNECT_TIMEOUT_S)
POOL_NAME = "crista-simulation-cache"


def cache_key(
    *,
    class_id: str,
    team_id: str,
    engine: str,
    engine_version: str,
    target_id: str,
    receptor_sha256: str,
    center: tuple[float, float, float],
    size: tuple[float, float, float],
    exhaustiveness: int,
    seed: int,
    num_modes: int,
    canonical_smiles: str,
    tool_versions: dict[str, str],
) -> str:
    doc = {
        "v": 1,
        "classId": class_id,
        "teamId": team_id,
        "engine": engine,
        "engineVersion": engine_version,
        "targetId": target_id,
        "receptorSha256": receptor_sha256,
        "box": {"center": [round(c, 3) for c in center], "size": [round(s, 3) for s in size]},
        "exhaustiveness": exhaustiveness,
        "seed": seed,
        "numModes": num_modes,
        "canonicalSmiles": canonical_smiles,
        "tools": dict(sorted(tool_versions.items())),
    }
    raw = json.dumps(doc, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
    return hashlib.sha256(raw.encode()).hexdigest()


class ResultCache(Protocol):
    kind: str

    async def get(self, key: str) -> DockingOutcome | None: ...

    async def put(self, key: str, *, class_id: str, team_id: str, outcome: DockingOutcome) -> None: ...

    async def close(self) -> None: ...


class MemoryCache:
    kind = "memory"

    def __init__(self) -> None:
        self._entries: dict[str, dict] = {}
        self.hits: dict[str, int] = {}

    async def get(self, key: str) -> DockingOutcome | None:
        data = self._entries.get(key)
        if data is None:
            return None
        self.hits[key] = self.hits.get(key, 0) + 1
        return DockingOutcome.from_json(data)

    async def put(self, key: str, *, class_id: str, team_id: str, outcome: DockingOutcome) -> None:
        # JSON 으로 한 번 왕복시켜 DB 저장과 같은 형태로 둔다.
        self._entries[key] = json.loads(json.dumps(outcome.to_json()))

    def clear(self) -> None:
        self._entries.clear()
        self.hits.clear()

    async def close(self) -> None:
        """닫을 연결이 없다 — 앱 종료 때 `PostgresCache` 와 같은 방식으로 부를 수 있게 둔다."""


class PostgresCache:
    kind = "postgres"

    def __init__(self, url: str, *, pool_timeout_s: float = POOL_TIMEOUT_S) -> None:
        self._url = url
        self._pool_timeout_s = pool_timeout_s
"""
분자 물성 계산(v5) — `POST /molecule/properties`. 게임 서버가 물질특허 출원 때 **과금 전에** 부른다(균형안 §10.2 · §10.3).

- 정규화 · 입력 검증은 도킹(Stage 3)과 **같은 함수**(`docking.validate.validate_smiles`)다 — 길이 · 원소 · 조각(반대이온) ·
  원자 수 · 분자량 · 회전 결합 상한이 같고, `canonicalSmiles` 는 도킹 작업 산출물(`artifacts.canonicalSmiles`)과 같은 문자열이다.
- `flatSmiles`(특허의 같은 물질 판정 단위)는 그 정규 SMILES 를 기존 `flat_canonical` 에 넣은 값(입체 정보를 뺀 가장 큰 조각).
- 계산 항목 · 반올림 · SMARTS 는 브리프 §6.3 그대로. 물성 → 위험 신호 규칙은 game-rules 순수 함수가 한다(여기서는 계산만).
- RDKit 는 처음 쓸 때 불러온다 — fixture 모드는 RDKit 없이도 돈다. 못 불러오면 `PropertiesUnavailable`(503 `worker_unavailable`).
"""

from __future__ import annotations

import functools
from typing import Any

from .docking.errors import InvalidDockingInput
from .models import MoleculeProperties, StructuralAlertId

# 염기성 지방족 아민 — 아마이드 · 싸이오아마이드 · 아미딘 · 방향족 아민 · 설폰아마이드 · 나이트릴 · 이민 질소 제외(브리프 §6.3).
BASIC_AMINE_SMARTS = "[NX3;H0,H1,H2;!$(N-C=[O,S,N]);!$(N-a);!$(N-S(=O));!$(N#*);!$(N=*)]"
# 구조 경고(반응성 대사체 — 간독성 신호). 방향족 니트로는 전하 분리형 · 5가 표기 둘 다 잡는다.
#
# `aromatic_amine`(v11): 방향족 1차 아민(아닐린)과 방향족-지방족 2차 아민만 센다. 질소가 **방향족 고리 둘 사이**에 낀
# 디아릴아민(`c-NH-c`)은 뺀다(`!$(N(c)c)`) — 4-아닐리노퀴나졸린(엘로티닙 · 게피티닙 등 EGFR 억제제)의 연결부가 여기에 해당하고,
# 이 질소는 아닐린과 달리 N-하이드록실화 → 나이트로소 반응성 대사체 경로를 타지 않는다. 아마이드 질소는 그대로 뺀다(`!$(NC=O)`).
ALERT_SMARTS: dict[StructuralAlertId, tuple[str, ...]] = {
    "aromatic_amine": ("[c][NX3;H2,H1;!$(NC=O);!$(N(c)c)]",),
    "nitro_aromatic": ("c[N+](=O)[O-]", "cN(=O)=O"),
}


class PropertiesUnavailable(RuntimeError):
    """RDKit 를 불러올 수 없다 — 503 `worker_unavailable`(재시도 가능)."""


@functools.cache
def _rdkit() -> dict[str, Any]:
    """RDKit 모듈과 미리 컴파일한 SMARTS. 실패하면 ImportError 를 그대로 올린다(캐시하지 않는다)."""
    import rdkit
    from rdkit import Chem
    from rdkit.Chem import QED, Crippen, Descriptors, Lipinski, rdMolDescriptors

    from .docking.validate import flat_canonical, validate_smiles

    basic = Chem.MolFromSmarts(BASIC_AMINE_SMARTS)
    alerts = {k: tuple(Chem.MolFromSmarts(s) for s in pats) for k, pats in ALERT_SMARTS.items()}
    if basic is None or any(p is None for pats in alerts.values() for p in pats):  # pragma: no cover — 상수 오타 방지
        raise RuntimeError("물성 SMARTS 를 읽지 못했습니다")
    return {
        "version": rdkit.__version__,
        "Descriptors": Descriptors,
        "Crippen": Crippen,
        "Lipinski": Lipinski,
        "rdMolDescriptors": rdMolDescriptors,
        "QED": QED,
        "basic": basic,
        "alerts": alerts,
        "validate_smiles": validate_smiles,
        "flat_canonical": flat_canonical,
    }


def rdkit_available() -> bool:
    """`/healthz` 의 `properties` — RDKit 를 불러올 수 있는가."""
    try:
        _rdkit()
    except Exception:  # noqa: BLE001 — ImportError 뿐 아니라 깨진 설치(OSError 등)도 '못 씀'
        return False
    return True


def engine_label() -> str:
    return f"RDKit {_rdkit()['version']}"


def _round(value: float, digits: int) -> float:
    """반올림하고 −0.0 을 0.0 으로(JSON 에 '-0.0' 이 나가지 않게)."""
    return round(value, digits) + 0.0


def compute_properties(raw: object) -> MoleculeProperties:
    """SMILES 하나 → 물성. 계산할 수 없는 입력은 `InvalidDockingInput`(400), RDKit 없음은 `PropertiesUnavailable`(503)."""
    try:
        rd = _rdkit()
    except Exception as exc:  # noqa: BLE001
        raise PropertiesUnavailable(f"물성 계산 도구(RDKit)를 불러오지 못했습니다: {type(exc).__name__}") from exc

    ligand = rd["validate_smiles"](raw)  # 도킹과 같은 검증 · 정규화(주 조각)
    mol = ligand.mol
    flat = rd["flat_canonical"](ligand.canonical_smiles)
    if flat is None:  # pragma: no cover — 방금 RDKit 가 쓴 정규 SMILES 는 다시 읽힌다
        raise InvalidDockingInput("정규화한 SMILES 를 다시 읽지 못했습니다.")

    Descriptors, Crippen, Lipinski = rd["Descriptors"], rd["Crippen"], rd["Lipinski"]
    rdm, QED = rd["rdMolDescriptors"], rd["QED"]
    alerts: list[StructuralAlertId] = [
        kind for kind, pats in rd["alerts"].items() if any(mol.HasSubstructMatch(p) for p in pats)
    ]
    return MoleculeProperties(
        canonicalSmiles=ligand.canonical_smiles,
        flatSmiles=flat,
        mw=_round(Descriptors.MolWt(mol), 1),
        clogp=_round(Crippen.MolLogP(mol), 2),
        tpsa=_round(rdm.CalcTPSA(mol), 1),
        hbd=Lipinski.NumHDonors(mol),
        hba=Lipinski.NumHAcceptors(mol),
        rotb=Lipinski.NumRotatableBonds(mol),
        aromaticRings=rdm.CalcNumAromaticRings(mol),
        qed=_round(QED.qed(mol), 2),
        basicAmines=len(mol.GetSubstructMatches(rd["basic"])),
        alerts=alerts,
        engine=f"RDKit {rd['version']}",
    )

