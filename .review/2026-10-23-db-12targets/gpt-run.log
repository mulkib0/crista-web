#!/usr/bin/env python
"""
Stage 2 3D 사전 스크리닝 — 화합물 라이브러리 전체를 네 도킹 표적에 실제 AutoDock Vina 로 도킹한다(오프라인 1회).

    .venv/bin/python scripts/prescreen_library.py                 # 빠진 (표적, 분자)만 계산해 진행 기록에 덧붙인다
    .venv/bin/python scripts/prescreen_library.py --jobs 4 --cpu 2

- 설정은 Stage 3 와 같다(RDKit ETKDGv3 + MMFF94 → Meeko → Vina 1.2.7, exhaustiveness 8 · seed 42 · 상자 22Å).
  같은 분자를 Stage 3 에서 도킹하면 같은 1위 ΔG 가 나온다(seed 고정 · CPU 수와 무관함을 `redock_check.py --check` 로 확인했다).
- 결과는 `data/cache/vina_prescreen.jsonl`(커밋하지 않는 진행 기록, 한 줄 = 한 계산)에 쌓인다. 중간에 멈춰도 다시 돌리면 이어서 한다.
  `prepare_datasets.py --offline` 이 이 기록을 읽어 `compound_library.json` 의 `vinaKcalByTarget` 을 채운다.
- PLIP 상호작용 분석은 하지 않는다(순위에는 1위 ΔG 만 쓴다).
"""

from __future__ import annotations

import argparse
import asyncio
import json
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from app.config import TARGETS_DIR, default_vina_path  # noqa: E402
from app.docking.errors import InvalidDockingInput, VinaFailed  # noqa: E402
from app.docking.ligand import prepare_ligand  # noqa: E402
from app.docking.targets import load_targets  # noqa: E402
from app.docking.validate import validate_smiles  # noqa: E402
from app.docking.vina import VinaSettings, check_binary, parse_modes, run_vina  # noqa: E402

LIBRARY = ROOT / "data" / "datasets" / "compound_library.json"
PROGRESS = ROOT / "data" / "cache" / "vina_prescreen.jsonl"


def record_key(target_id: str, smiles: str) -> str:
    return f"{target_id}|{smiles}"


def load_progress(path: Path = PROGRESS) -> dict[str, dict]:
    """진행 기록 → {"<targetId>|<canonicalSmiles>": 기록}. 같은 키가 여러 번이면 마지막 줄."""
    out: dict[str, dict] = {}
    if not path.exists():
        return out
    for line in path.read_text().splitlines():
        if line.strip():
            rec = json.loads(line)
            out[record_key(rec["targetId"], rec["canonicalSmiles"])] = rec
    return out


async def dock_one(sem: asyncio.Semaphore, *, binary: Path, target, smiles: str, settings: VinaSettings, cpu: int) -> dict:
    async with sem:
        t0 = time.monotonic()
        rec: dict = {"targetId": target.id, "canonicalSmiles": smiles, "receptorSha256": target.receptor_sha256}
        try:
            ligand = validate_smiles(smiles)
            prepared = await asyncio.to_thread(prepare_ligand, ligand.mol)
            with tempfile.TemporaryDirectory(prefix="crista-prescreen-") as tmp:
                lig = Path(tmp) / "ligand.pdbqt"
                out = Path(tmp) / "out.pdbqt"
                lig.write_text(prepared.pdbqt)
                text = await run_vina(
                    binary=binary,
                    receptor=target.receptor_pdbqt,
                    ligand=lig,
                    out=out,
                    center=target.center,
                    size=target.size,
                    settings=settings,
                    cpu=cpu,
                )
            modes = parse_modes(text)
            if not modes:
                raise VinaFailed("포즈 없음")
            rec["kcal"] = round(modes[0].affinity, 2)
        except (InvalidDockingInput, VinaFailed) as exc:
            rec["kcal"] = None
            rec["error"] = f"{type(exc).__name__}: {exc}"[:200]
        rec["computeMs"] = int((time.monotonic() - t0) * 1000)
        return rec


async def run(jobs: int, cpu: int, limit: int | None) -> int:
    binary = default_vina_path()
    version = check_binary(binary)
    settings = VinaSettings()
    targets = load_targets(TARGETS_DIR)
    library = json.loads(LIBRARY.read_text())
    smiles_list = [c["canonicalSmiles"] for c in library["compounds"]]
    done = load_progress()
    todo = [
        (t, s)
        for t in targets.values()
        for s in smiles_list
        if (prev := done.get(record_key(t.id, s))) is None or prev.get("receptorSha256") != t.receptor_sha256
    ]
    if limit is not None:
        todo = todo[:limit]
    total = len(todo)
    print(f"· Vina {version} · exhaustiveness {settings.exhaustiveness} · seed {settings.seed} · 남은 계산 {total}건 (동시 {jobs} × cpu {cpu})")
    if not todo:
        return 0
    PROGRESS.parent.mkdir(parents=True, exist_ok=True)
    sem = asyncio.Semaphore(jobs)
    t0 = time.monotonic()
    finished = 0
    tasks = [asyncio.create_task(dock_one(sem, binary=binary, target=t, smiles=s, settings=settings, cpu=cpu)) for t, s in todo]
    with PROGRESS.open("a") as fh:
        for fut in asyncio.as_completed(tasks):
            rec = await fut
            rec["engine"] = f"AutoDock Vina {version}"
            rec["exhaustiveness"] = settings.exhaustiveness
            rec["seed"] = settings.seed
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
            fh.flush()
            finished += 1
            if finished % 20 == 0 or finished == total:
                elapsed = time.monotonic() - t0
                eta = elapsed / finished * (total - finished)
                print(f"  {finished}/{total} · 경과 {elapsed / 60:.1f}분 · 남은 예상 {eta / 60:.1f}분", flush=True)
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    parser.add_argument("--jobs", type=int, default=4, help="동시에 돌리는 도킹 수(기본 4)")
    parser.add_argument("--cpu", type=int, default=2, help="도킹 1건의 Vina --cpu(기본 2)")
    parser.add_argument("--limit", type=int, default=None, help="이번에 계산할 최대 건수(시험용)")
    args = parser.parse_args(argv)
    return asyncio.run(run(args.jobs, args.cpu, args.limit))


if __name__ == "__main__":
    sys.exit(main())
#!/usr/bin/env python
"""
결정 리간드 재도킹 기준값 — 네 표적의 공결정 리간드를 Stage 3 와 같은 설정으로 도킹해 `target.json` 에 적는다.

    .venv/bin/python scripts/redock_check.py              # 네 표적 모두 계산해 target.json 에 기록
    .venv/bin/python scripts/redock_check.py egfr-1m17    # 한 표적만
    .venv/bin/python scripts/redock_check.py --check      # 다시 계산해 기록값과 같은지만 확인(쓰지 않는다)

기록하는 값(설계 docs/2026-10-23-real-db-multi-target-upgrade-design.md Upgrade 2):
- `referenceKcal` — 결정 리간드 1위 포즈의 Vina 결합 자유에너지(kcal/mol). 게임 규칙의 표적별 결합력 정규화 기준
  (`@crista/game-rules` `potency(affinityKcal, referenceKcal)`), protocol.ts `DOCKING_TARGETS[].referenceKcal` 과 같은 값.
- `referenceRmsd` — 1위 포즈와 결정구조 포즈의 중원자 RMSD(Å). 2Å 이하면 이 수용체 · 상자 설정이 실험 포즈를 재현한다.
- `redock` — 재현에 필요한 설정(Vina 버전 · exhaustiveness · seed · cpu · 수용체 sha256 · 측정 시각).

설정은 워커 `DockingService` 그대로(RDKit ETKDGv3 + MMFF94 → Meeko → Vina 1.2.7, exhaustiveness 8 · seed 42).
수용체 파일이 바뀌면(`prepare_target.py`) 기준값도 다시 재야 한다 — `redock.receptorSha256` 이 그 근거다.
"""

from __future__ import annotations

import argparse
import asyncio
import json
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from app.config import TARGETS_DIR, Settings, default_vina_path  # noqa: E402
from app.docking.pipeline import DockingService  # noqa: E402

TARGET_IDS = ("ache-4ey7", "egfr-1m17", "dpp4-1x70", "cox2-3ln1")
SCRIPT_VERSION = "redock_check/1"


def service(cpu: int) -> DockingService:
    settings = Settings(
        mode="compute",
        dock_cpu=cpu,
        max_concurrent=1,
        timeout_ms=600_000,
        database_url=None,
        vina_path=default_vina_path(),
        targets_dir=TARGETS_DIR,
    )
    return DockingService(settings)


async def redock(svc: DockingService, target_id: str) -> dict:
    target = svc.targets[target_id]
    req = svc.validate({"targetId": target_id, "smiles": target.reference_smiles}, class_id="redock", team_id="redock")
    t0 = time.monotonic()
    outcome = await svc.compute(req, on_phase=lambda *_: None)
    if outcome.redock_rmsd is None:
        raise RuntimeError(f"{target_id}: 결정 리간드로 인식되지 않았습니다 — RMSD 를 잴 수 없습니다")
    v = svc.vina_settings
    return {
        "referenceKcal": round(outcome.best.affinity, 2),
        "referenceRmsd": round(outcome.redock_rmsd, 2),
        "redock": {
            "engine": f"AutoDock Vina {svc.vina_version}",
            "exhaustiveness": v.exhaustiveness,
            "seed": v.seed,
            "numModes": v.num_modes,
            "cpu": svc.settings.dock_cpu,
            "receptorSha256": target.receptor_sha256,
            "script": SCRIPT_VERSION,
            "computeMs": int((time.monotonic() - t0) * 1000),
            "measuredAt": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
        },
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[1])
    parser.add_argument("targets", nargs="*", help=f"표적 id(생략하면 넷 다): {', '.join(TARGET_IDS)}")
    parser.add_argument("--check", action="store_true", help="쓰지 않고 기록값과 같은지만 확인")
    parser.add_argument("--cpu", type=int, default=4, help="Vina --cpu (기본 4)")
    args = parser.parse_args(argv)
    unknown = [t for t in args.targets if t not in TARGET_IDS]
    if unknown:
        parser.error(f"모르는 표적: {', '.join(unknown)}")

    svc = service(args.cpu)
    ok = True
    for target_id in args.targets or TARGET_IDS:
        path = TARGETS_DIR / target_id / "target.json"
        meta = json.loads(path.read_text())
        got = asyncio.run(redock(svc, target_id))
        verdict = "통과" if got["referenceRmsd"] <= 2.0 else "RMSD 2Å 초과"
        print(f"  {target_id}  ΔG {got['referenceKcal']:.2f} kcal/mol · RMSD {got['referenceRmsd']:.2f} Å ({verdict}) · {got['redock']['computeMs']} ms")
        if args.check:
            same = meta.get("referenceKcal") == got["referenceKcal"] and meta.get("referenceRmsd") == got["referenceRmsd"]
            print(f"    기록 {meta.get('referenceKcal')} / {meta.get('referenceRmsd')} → {'같음' if same else '다름'}")
            ok = ok and same
            continue
        prev = meta.get("redock") or {}
        same = meta.get("referenceKcal") == got["referenceKcal"] and meta.get("referenceRmsd") == got["referenceRmsd"]
        if same and prev.get("receptorSha256") == got["redock"]["receptorSha256"]:
            # 값이 그대로면 측정 기록도 그대로(다시 돌려도 git 변경이 생기지 않는다).
            got["redock"]["measuredAt"] = prev.get("measuredAt", got["redock"]["measuredAt"])
            got["redock"]["computeMs"] = prev.get("computeMs", got["redock"]["computeMs"])
        meta.update(got)
        path.write_text(json.dumps(meta, ensure_ascii=False, indent=2) + "\n")
    if args.check:
        print("결과:", "기록된 재도킹 기준값과 같습니다" if ok else "다릅니다 — 다시 기록해야 합니다")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())

