"""
결과 해석 — Vina 출력 PDBQT → RDKit 포즈(Meeko `RDKitMolCreate`) → SDF · 결정구조 대비 RMSD · PLIP 상호작용.
"""

from __future__ import annotations

import logging
import threading
from dataclasses import asdict, dataclass
from pathlib import Path

from rdkit import Chem
from rdkit.Chem import rdMolAlign

from .errors import AnalysisFailed

logger = logging.getLogger("crista.bio-worker")

# PLIP 는 전역 설정(`plip.basic.config`)과 Open Babel 객체를 쓴다 — 한 번에 하나만 돌린다.
_PLIP_LOCK = threading.Lock()

# PLIP 상호작용 종류 → (표 문구, 정렬 순서)
INTERACTION_KINDS: dict[str, tuple[str, int]] = {
    "hbond": ("수소결합", 0),
    "saltbridge": ("염다리", 1),
    "pication": ("π-양이온", 2),
    "pistacking": ("π-스태킹", 3),
    "halogen": ("할로겐 결합", 4),
    "hydrophobic": ("소수성 접촉", 5),
}


@dataclass
class Interaction:
    kind: str  # INTERACTION_KINDS 의 키
    residue: str  # 'TRP86'
    chain: str
    distance: float  # Å — 수소결합은 공여체-수용체, π 계열은 고리 중심 사이
    detail: str = ""  # π-스태킹 'P'(평행)/'T'(T자형) 등

    def to_dict(self) -> dict:
        return asdict(self)


def poses_from_pdbqt(out_pdbqt: str) -> Chem.Mol:
    """Vina 출력 → 포즈마다 배좌 하나를 가진 RDKit 분자(수소 포함)."""
    from meeko import PDBQTMolecule, RDKitMolCreate

    pdbqt_mol = PDBQTMolecule(out_pdbqt, is_dlg=False, skip_typing=True)
    mols = RDKitMolCreate.from_pdbqt_mol(pdbqt_mol)
    if not mols or mols[0] is None:
        raise AnalysisFailed("도킹 포즈를 분자로 되돌리지 못했습니다(Meeko RDKitMolCreate)")
    return mols[0]


def single_pose(poses: Chem.Mol, conf_id: int = 0) -> Chem.Mol:
    pose = Chem.Mol(poses)
    conf = Chem.Conformer(poses.GetConformer(conf_id))
    pose.RemoveAllConformers()
    pose.AddConformer(conf, assignId=True)
    return pose


def pose_sdf(pose: Chem.Mol, *, name: str, affinity: float) -> str:
    mol = Chem.Mol(pose)
    mol.SetProp("_Name", name)
    mol.SetProp("vina_affinity_kcal_mol", f"{affinity:.3f}")
    block = Chem.MolToMolBlock(mol)
    lines = block.split("\n")
    # 2번째 줄의 생성 시각을 지운다 — 같은 계산은 같은 파일을 내야 캐시·비교가 쉽다.
    if len(lines) > 1:
        lines[1] = "     RDKit          3D"
    props = f">  <vina_affinity_kcal_mol>\n{affinity:.3f}\n\n"
    return "\n".join(lines) + props + "$$$$\n"


def redock_rmsd(pose: Chem.Mol, reference_sdf: Path) -> float:
    """1위 포즈와 결정구조 리간드의 중원자 RMSD(Å) — 정렬하지 않고(같은 좌표계) 대칭을 고려한다."""
    ref = Chem.MolFromMolFile(str(reference_sdf))
    if ref is None:
        raise AnalysisFailed("결정 리간드 SDF 를 읽지 못했습니다")
    probe = Chem.RemoveHs(pose)
    return float(rdMolAlign.CalcRMS(probe, ref))


def _ligand_pdb_lines(pose: Chem.Mol, serial_offset: int) -> list[str]:
    mol = Chem.Mol(pose)
    counts: dict[str, int] = {}
    for atom in mol.GetAtoms():
        sym = atom.GetSymbol()
        counts[sym] = counts.get(sym, 0) + 1
        name = f"{sym}{counts[sym]}"[:4]
        info = Chem.AtomPDBResidueInfo()
        info.SetName(f" {name:<3}" if len(sym) == 1 and len(name) < 4 else f"{name:<4}")
        info.SetResidueName("LIG")
        info.SetChainId("Z")
        info.SetResidueNumber(1)
        info.SetIsHeteroAtom(True)
        atom.SetMonomerInfo(info)
    out = []
    for line in Chem.MolToPDBBlock(mol).splitlines():
        if line.startswith("HETATM"):
            out.append(f"{line[:6]}{int(line[6:11]) + serial_offset:5d}{line[11:]}")
        elif line.startswith("CONECT"):
            nums = [int(line[i : i + 5]) for i in range(6, len(line), 5) if line[i : i + 5].strip()]
            out.append("CONECT" + "".join(f"{n + serial_offset:5d}" for n in nums))
    return out


def complex_pdb(receptor_h_pdb: str, pose: Chem.Mol) -> str:
    rec = [ln for ln in receptor_h_pdb.splitlines() if ln.startswith(("ATOM", "HETATM", "TER"))]
    max_serial = max(int(ln[6:11]) for ln in rec if ln.startswith(("ATOM", "HETATM")))
    return "\n".join(rec + _ligand_pdb_lines(pose, max_serial) + ["END"]) + "\n"


def plip_interactions(receptor_h_pdb: str, pose: Chem.Mol) -> list[Interaction]:
    """PLIP 로 수소결합·소수성·π-스태킹·π-양이온·염다리·할로겐 결합을 찾는다."""
    text = complex_pdb(receptor_h_pdb, pose)
    with _PLIP_LOCK:
        from plip.basic import config as plip_config

        plip_config.NOHYDRO = True  # 수용체·리간드 모두 수소를 이미 가졌다
        plip_config.QUIET = True
        logging.getLogger("plip").setLevel(logging.ERROR)
        from plip.structure.preparation import PDBComplex

        cplx = PDBComplex()
        cplx.load_pdb(text, as_string=True)
        cplx.analyze()
        sets = [s for key, s in cplx.interaction_sets.items() if key.startswith("LIG:Z:")]
    if not sets:
        raise AnalysisFailed("PLIP 이 도킹 리간드를 찾지 못했습니다")
    s = sets[0]
    found: list[Interaction] = []

    def add(kind: str, items, dist_attr: str, detail_attr: str | None = None) -> None:
        for it in items:
            found.append(
                Interaction(
                    kind=kind,
                    residue=f"{it.restype}{it.resnr}",
                    chain=str(it.reschain),
                    distance=round(float(getattr(it, dist_attr)), 2),
                    detail=str(getattr(it, detail_attr, "")) if detail_attr else "",
                )
            )

    add("hbond", list(s.hbonds_ldon) + list(s.hbonds_pdon), "distance_ad")
    add("hydrophobic", s.hydrophobic_contacts, "distance")
    add("pistacking", s.pistacking, "distance", "type")
    add("pication", list(s.pication_laro) + list(s.pication_paro), "distance")
    add("saltbridge", list(s.saltbridge_lneg) + list(s.saltbridge_pneg), "distance")
    add("halogen", s.halogen_bonds, "distance")
    found.sort(key=lambda i: (INTERACTION_KINDS[i.kind][1], i.distance, i.residue))
    return found
"""표적 파일 — protocol.ts DOCKING_TARGETS 와 같은 값, 해시 대조, 준비 스크립트 재현성."""

from __future__ import annotations

import json
import re
import shutil

import pytest

from app.config import TARGETS_DIR, ConfigError
from app.docking.targets import load_target, load_targets

from .conftest import WORKER_ROOT, protocol_text


def test_target_matches_protocol_ts():
    text = protocol_text()
    block = text[text.index("export const DOCKING_TARGETS"):]
    block = block[: block.index("];")]
    ids = re.findall(r"id: '([^']+)'", block)
    pdb = re.findall(r"pdbId: '([^']+)'", block)
    smiles = re.findall(r"smiles: '([^']+)'", block)
    targets = load_targets(TARGETS_DIR)
    assert sorted(targets) == sorted(ids)
    for tid, p_id, smi in zip(ids, pdb, smiles, strict=True):
        meta = json.loads((TARGETS_DIR / tid / "target.json").read_text())
        assert meta["pdbId"] == p_id
        assert meta["referenceLigand"]["smiles"] == smi
        assert meta["box"]["size"] == [22.0, 22.0, 22.0]
    # 결정 리간드 중원자 중심 — 4EY7 E20(A 사슬)
    meta0 = json.loads((TARGETS_DIR / ids[0] / "target.json").read_text())
    assert meta0["box"]["center"] == pytest.approx([-14.108, -43.833, 27.67], abs=1e-3)


def test_receptor_pdbqt_has_only_vina_records():
    for path in sorted(TARGETS_DIR.glob("*/receptor.pdbqt")):
        lines = path.read_text().splitlines()
        assert lines and all(ln.startswith(("ATOM", "HETATM", "TER")) for ln in lines), path.parent.name


def test_hash_mismatch_blocks_startup(tmp_path):
    src = TARGETS_DIR / "ache-4ey7"
    dst = tmp_path / "ache-4ey7"
    shutil.copytree(src, dst)
    load_target(dst)  # 원본 그대로는 통과
    with (dst / "receptor.pdbqt").open("a") as fh:
        fh.write("TER\n")
    with pytest.raises(ConfigError, match="해시"):
        load_target(dst)


