# crista-web 환경 변수 — 값은 .env.local 에만(커밋 금지). .env.local 은 crista 저장소의 같은 파일을 복사해 시작했다.

# ── crista 에서 복사한 값(같은 Supabase 프로젝트 · 같은 키) ──
OPENROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 — GoTrue 관리자(웹 계정 발급 @web.crista.test). 브라우저로 보내지 않는다.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
RUNPOD_API_KEY=
SUPABASE_ACCESS_TOKEN=
DATABASE_URL=
DIRECT_URL=
# 관리자 연결(session pooler) — db/migrations/0000_bootstrap 한 번에만 쓴다.
CRISTA_DATABASE_URL=

# ── crista-web 전용 ──
# 로컬은 `tools/with-local-env.mjs` 가 crista 폴더의 `supabase status` 에서 아래 값을 로컬 값으로 채워 넘긴다(위의 호스팅 값을 덮어쓴다).
# 로컬 Supabase 의 crista_web 역할 비밀번호 — 도구가 처음 실행 때 무작위로 만들어 .env.local 에 덧붙인다(로컬 전용).
WEB_LOCAL_DB_PASSWORD=
# 호스팅 Supabase 의 crista_web 비밀번호 — tools/with-hosted-env.mjs 가 처음 실행 때 무작위로 만들어 덧붙인다(Railway 변수 WEB_DATABASE_URL 에 들어간다).
WEB_HOSTED_DB_PASSWORD=
# 게이트웨이(Cloudflare Worker deploy/gateway) ↔ 호스팅 서버 공유 비밀 — 같은 도구가 만든다. 호스팅 서버는 이 값이 없으면 시작하지 않는다.
WEB_GATEWAY_SECRET=
# local | hosted — local 이면 서버 · 실행기가 루프백 주소만 받는다.
WEB_TARGET=
# 전용 역할 crista_web 연결 — web 스키마 밖은 권한 없음(호스팅 값은 W6 에서).
WEB_DATABASE_URL=
WEB_PGSSLROOTCERT=certs/supabase-prod-ca-2021.crt
# 로컬: crista 워커를 8790 으로 띄운다 · Railway: http://bio-worker.railway.internal:8787
BIO_WORKER_URL=http://127.0.0.1:8790
WEB_PORT=3390
WEB_AUTH_EMAIL_DOMAIN=web.crista.test
# 선택 — 기본: 로컬 127.0.0.1 · 호스팅 0.0.0.0
WEB_HOST=
# 선택 — 상태를 바꾸는 요청 · WebSocket 의 Origin 허용 목록(쉼표). 로컬은 5190 · 3390 이 기본으로 들어 있다.
WEB_ALLOWED_ORIGINS=
# 선택 — 공개 경로 접두(기본 /crista — https://mulk.codes/crista). 쿠키 Path 도 이 값.
WEB_BASE_PATH=
# 선택 — 화면 빌드 폴더(기본 apps/web/dist, W2)
WEB_STATIC_DIR=
# 선택 — 1 이면 X-Forwarded-For 를 믿는다(호스팅은 늘 믿는다)
WEB_TRUST_PROXY=
# 선택 — crista 저장소 위치(기본 ../crista). 로컬 Supabase 상태를 그 폴더에서 읽는다.
CRISTA_REPO=
