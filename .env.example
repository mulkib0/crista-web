# crista-web 환경 변수 — 값은 .env.local 에만(커밋 금지). .env.local 은 crista 저장소의 같은 파일을 복사해 시작했다.

# ── crista 에서 복사한 값(같은 Supabase 프로젝트 · 같은 키) ──
OPENROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 — GoTrue 관리자(웹 계정 발급 @web.crista.test). 브라우저로 보내지 않는다.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
RUNPOD_API_KEY=
SUPABASE_ACCESS_TOKEN=
DATABASE_URL=
DIRECT_URL=
# 관리자 연결(session pooler) — db/migrations/0000_bootstrap 한 번에만 쓴다.
CRISTA_DATABASE_URL=

# ── crista-web 전용 ──
# 로컬은 `tools/with-local-env.mjs` 가 crista 폴더의 `supabase status` 에서 아래 값을 로컬 값으로 채워 넘긴다(위의 호스팅 값을 덮어쓴다).
# 로컬 Supabase 의 crista_web 역할 비밀번호 — 도구가 처음 실행 때 무작위로 만들어 .env.local 에 덧붙인다(로컬 전용).
WEB_LOCAL_DB_PASSWORD=
# 호스팅 Supabase 의 crista_web 비밀번호 — tools/with-hosted-env.mjs 가 처음 실행 때 무작위로 만들어 덧붙인다(Railway 변수 WEB_DATABASE_URL 에 들어간다).
WEB_HOSTED_DB_PASSWORD=
# 게이트웨이(Cloudflare Worker deploy/gateway) ↔ 호스팅 서버 공유 비밀 — 같은 도구가 만든다. 호스팅 서버는 이 값이 없으면 시작하지 않는다.
WEB_GATEWAY_SECRET=
# local | hosted — local 이면 서버 · 실행기가 루프백 주소만 받는다.
WEB_TARGET=
# 전용 역할 crista_web 연결 — web 스키마 밖은 권한 없음(호스팅 값은 W6 에서).
WEB_DATABASE_URL=
WEB_PGSSLROOTCERT=certs/supabase-prod-ca-2021.crt
# 로컬: crista 워커를 8790 으로 띄운다 · Railway: http://bio-worker.railway.internal:8787
BIO_WORKER_URL=http://127.0.0.1:8790
WEB_PORT=3390
WEB_AUTH_EMAIL_DOMAIN=web.crista.test
# 선택 — 기본: 로컬 127.0.0.1 · 호스팅 0.0.0.0
WEB_HOST=
# 선택 — 상태를 바꾸는 요청 · WebSocket 의 Origin 허용 목록(쉼표). 로컬은 5190 · 3390 이 기본으로 들어 있다.
WEB_ALLOWED_ORIGINS=
# 선택 — 공개 경로 접두(기본 /crista — https://mulk.codes/crista). 쿠키 Path 도 이 값.
WEB_BASE_PATH=
# 선택 — 화면 빌드 폴더(기본 apps/web/dist, W2)
WEB_STATIC_DIR=
# 선택 — 1 이면 X-Forwarded-For 를 믿는다(호스팅은 늘 믿는다)
WEB_TRUST_PROXY=
# 선택 — crista 저장소 위치(기본 ../crista). 로컬 Supabase 상태를 그 폴더에서 읽는다.
CRISTA_REPO=

# ── 파이프라인 LLM(설계 §5.13 — 서류 심사 · 학습 채점 · 전광판 헤드라인) ──
# SDK 가 직접 읽는 이름. 로컬은 tools/with-local-env.mjs 가 이 파일의 이 줄만 서버에 넘긴다(셸 전역 export 금지). 호스팅은 Railway 서비스 변수.
ANTHROPIC_API_KEY=
# 선택 — 기본 claude-opus-5-5 · medium. 바꾸면 심사관 · 채점 판(reviewerVersion · graderVersion)도 올린다.
LLM_MODEL=
LLM_EFFORT=
# 선택 — 1 이면 LLM 을 부르지 않는다(심사 · 채점은 pending → 교사 수동). 0 이면 서버 측 대체 실행(fallbacks 'default')을 끈다.
LLM_DISABLED=
LLM_FALLBACKS=
# 선택 — 동시 호출(서버 전체 4 · 학급 2) · 학급 하루 호출 상한(400) · 요청 시간 제한(ms, 180000)
LLM_MAX_CONCURRENT=
LLM_MAX_CONCURRENT_PER_CLASS=
LLM_DAILY_PER_CLASS=
LLM_TIMEOUT_MS=

# ── 항체 설계 랩(항체 설계 §3.3) — 모두 선택 ──
# 1 이면 외부 API 를 부르지 않는다(캐시 → 미리 받아 둔 참고 자료로만). 네트워크가 없는 교실 · 회귀 시험에 쓴다.
WEB_ANTIBODY_OFFLINE=
# 학술 공용 서버 예절 — 연락처를 포함한 User-Agent. 비우면 crista-web-edu/0.1 (… +https://mulk.codes/crista).
WEB_ANTIBODY_USER_AGENT=
# 시드 스크립트 전용 상한(기본 33554432 바이트 · 180000ms). SAbDab2 all-summary(17.5MB · 약 96초)를 받는 경로에만 쓴다.
WEB_ANTIBODY_SEED_MAX_BYTES=
WEB_ANTIBODY_SEED_TIMEOUT_MS=
# 선택 기능 — 없으면 교육용 근사로 강등하고 화면이 그 사실을 말한다. 키 발급 · 과금은 사용자 확인 뒤에만 한다.
# NVIDIA NIM ProteinMPNN(변이체 자동 제안). 없으면 규칙 기반 제안.
NVIDIA_API_KEY=
# Boltz 복합체 예측(복합체 신뢰도). 없으면 교육용 근사 설계 적합도.
BOLTZ_API_KEY=
